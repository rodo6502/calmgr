>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-SERVICE.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT REPORT-FILE ASSIGN TO "build/test-service.txt"
      ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS REPORT-STATUS.
    SELECT LIST-REPORT-FILE ASSIGN TO "build/test-service-list.txt"
      ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS LIST-REPORT-STATUS.
DATA DIVISION.
FILE SECTION.
FD REPORT-FILE.
01 REPORT-LINE PIC X(1024).
FD LIST-REPORT-FILE.
01 LIST-REPORT-LINE PIC X(1024).
WORKING-STORAGE SECTION.
COPY "appointment-status.cpy".
COPY "appointment-config.cpy".
COPY "appointment-service-request.cpy".
COPY "appointment-service-result.cpy".
COPY "appointment-repository-request.cpy".
COPY "appointment-record.cpy".
01 FAILURES PIC 99 VALUE 0.
01 CREATED-ID PIC X(9).
01 SERIES-ID PIC X(9).
01 LIST-COUNT PIC 99.
01 REPORT-COUNT PIC 999.
01 REPORT-STATUS PIC XX.
01 LIST-REPORT-STATUS PIC XX.
01 LIST-REPORT-COUNT PIC 999.
01 CALENDAR-HEADER-SEEN PIC X VALUE "N".
01 LIST-HEADER-SEEN PIC X VALUE "N".
01 CALENDAR-APPT-SEEN PIC X VALUE "N".
01 LIST-APPT-SEEN PIC X VALUE "N".
PROCEDURE DIVISION.
    INITIALIZE APPOINTMENT-CONFIG
    MOVE "build/test-service.db" TO AC-DATA-FILE
    MOVE "build/test-service.backup.db" TO AC-BACKUP-FILE
    MOVE "build/test-service.safety.db" TO AC-SAFETY-FILE
    MOVE "build/test-service.audit.log" TO AC-AUDIT-FILE
    MOVE "build/test-service.txt" TO AC-PRINT-FILE
    MOVE "build/test-service-list.txt" TO AC-LIST-PRINT-FILE
    MOVE "build/test-service.csv" TO AC-CSV-FILE
    MOVE "build/test-service.ics" TO AC-ICAL-FILE
    MOVE 20 TO AC-LINES-PER-PAGE
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "RESET-DATABASE" TO ASR-OPERATION MOVE "ERASE" TO ASR-CONFIRM
    PERFORM SERVICE
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "ADD" TO ASR-OPERATION MOVE 20250301 TO ASR-START-DATE ASR-END-DATE
    MOVE "Test Client" TO ASR-CLIENT MOVE "Test Subject" TO ASR-SUBJECT
    MOVE "N" TO ASR-RECURRENCE MOVE "TEST" TO ASR-SOURCE PERFORM SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK ADD 1 TO FAILURES END-IF
    MOVE ASO-ID TO CREATED-ID
    INITIALIZE APPOINTMENT-REPOSITORY-REQUEST APPOINTMENT-RECORD
    MOVE "OPEN-SCAN" TO ARR-OPERATION
    CALL "APPOINTMENT-REPOSITORY" USING APPOINTMENT-REPOSITORY-REQUEST
      APPOINTMENT-RECORD APPOINTMENT-CONFIG
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "BACKUP" TO ASR-OPERATION PERFORM SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK ADD 1 TO FAILURES END-IF
    MOVE "CLOSE-SCAN" TO ARR-OPERATION
    CALL "APPOINTMENT-REPOSITORY" USING APPOINTMENT-REPOSITORY-REQUEST
      APPOINTMENT-RECORD APPOINTMENT-CONFIG
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "ADD" TO ASR-OPERATION MOVE 20250301 TO ASR-START-DATE ASR-END-DATE
    MOVE "Test Client" TO ASR-CLIENT MOVE "Test Subject" TO ASR-SUBJECT
    MOVE "N" TO ASR-RECURRENCE PERFORM SERVICE
    IF ASO-STATUS-CODE NOT = APPT-DUPLICATE ADD 1 TO FAILURES END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "CANCEL" TO ASR-OPERATION MOVE CREATED-ID TO ASR-ID
    MOVE "single" TO ASR-SCOPE MOVE "test" TO ASR-CANCEL-NOTE PERFORM SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK OR ASO-STATUS NOT = "C" ADD 1 TO FAILURES END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "REACTIVATE" TO ASR-OPERATION MOVE CREATED-ID TO ASR-ID PERFORM SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK OR ASO-STATUS NOT = "A" ADD 1 TO FAILURES END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "PRINT-EXPORT" TO ASR-OPERATION
    MOVE 20250101 TO ASR-FROM-DATE
    MOVE 20251231 TO ASR-TO-DATE
    PERFORM SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK ADD 1 TO FAILURES END-IF
    OPEN INPUT REPORT-FILE
    PERFORM UNTIL REPORT-STATUS NOT = "00"
      READ REPORT-FILE
        AT END CONTINUE
        NOT AT END
          ADD 1 TO REPORT-COUNT
          IF REPORT-LINE(1:20) = "APPOINTMENT CALENDAR"
            MOVE "Y" TO CALENDAR-HEADER-SEEN
          END-IF
          IF REPORT-LINE(1:2) = "09"
            MOVE "Y" TO CALENDAR-APPT-SEEN
          END-IF
      END-READ
    END-PERFORM
    CLOSE REPORT-FILE
    IF REPORT-COUNT = 0 OR FUNCTION MOD(REPORT-COUNT, 20) NOT = 0
      OR CALENDAR-HEADER-SEEN NOT = "Y"
      OR CALENDAR-APPT-SEEN NOT = "Y"
      ADD 1 TO FAILURES
    END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "PRINT-LIST-EXPORT" TO ASR-OPERATION
    MOVE 20250101 TO ASR-FROM-DATE
    MOVE 20251231 TO ASR-TO-DATE
    PERFORM SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK ADD 1 TO FAILURES END-IF
    OPEN INPUT LIST-REPORT-FILE
    PERFORM UNTIL LIST-REPORT-STATUS NOT = "00"
      READ LIST-REPORT-FILE
        AT END CONTINUE
        NOT AT END
          ADD 1 TO LIST-REPORT-COUNT
          IF LIST-REPORT-LINE(1:16) = "APPOINTMENT LIST"
            MOVE "Y" TO LIST-HEADER-SEEN
          END-IF
          IF LIST-REPORT-LINE(32:11) = "TEST CLIENT"
            MOVE "Y" TO LIST-APPT-SEEN
          END-IF
      END-READ
    END-PERFORM
    CLOSE LIST-REPORT-FILE
    IF LIST-REPORT-COUNT = 0
      OR FUNCTION MOD(LIST-REPORT-COUNT, 20) NOT = 0
      OR LIST-HEADER-SEEN NOT = "Y"
      OR LIST-APPT-SEEN NOT = "Y"
      ADD 1 TO FAILURES
    END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "ADD" TO ASR-OPERATION MOVE 20250401 TO ASR-START-DATE ASR-END-DATE
    MOVE "Series Client" TO ASR-CLIENT MOVE "Weekly meeting" TO ASR-SUBJECT
    MOVE "W" TO ASR-RECURRENCE MOVE 20250415 TO ASR-SERIES-UNTIL PERFORM SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK OR ASO-COUNT NOT = 3 ADD 1 TO FAILURES END-IF
    MOVE ASO-ID TO SERIES-ID
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "EDIT" TO ASR-OPERATION MOVE SERIES-ID TO ASR-ID
    MOVE "series" TO ASR-SCOPE MOVE "Edited weekly meeting" TO ASR-SUBJECT
    PERFORM SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK OR ASO-COUNT NOT = 3 ADD 1 TO FAILURES END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "LIST-OPEN" TO ASR-OPERATION MOVE SERIES-ID TO ASR-SERIES-ID
    MOVE "client" TO ASR-SORT PERFORM SERVICE
    MOVE 0 TO LIST-COUNT
    PERFORM UNTIL ASO-STATUS-CODE = APPT-NOT-FOUND
      MOVE "LIST-NEXT" TO ASR-OPERATION PERFORM SERVICE
      IF ASO-STATUS-CODE = APPT-OK ADD 1 TO LIST-COUNT END-IF
    END-PERFORM
    MOVE "LIST-CLOSE" TO ASR-OPERATION PERFORM SERVICE
    IF LIST-COUNT NOT = 3 ADD 1 TO FAILURES END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "CANCEL" TO ASR-OPERATION MOVE SERIES-ID TO ASR-ID
    MOVE "series" TO ASR-SCOPE MOVE "series test" TO ASR-CANCEL-NOTE PERFORM SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK OR ASO-COUNT NOT = 3 ADD 1 TO FAILURES END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "REACTIVATE" TO ASR-OPERATION MOVE SERIES-ID TO ASR-ID PERFORM SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK ADD 1 TO FAILURES END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "BACKUP" TO ASR-OPERATION PERFORM SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK ADD 1 TO FAILURES END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "EDIT" TO ASR-OPERATION MOVE SERIES-ID TO ASR-ID
    MOVE "single" TO ASR-SCOPE MOVE "Temporary client" TO ASR-CLIENT PERFORM SERVICE
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "RESTORE" TO ASR-OPERATION MOVE "RESTORE" TO ASR-CONFIRM PERFORM SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK ADD 1 TO FAILURES END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "SHOW" TO ASR-OPERATION MOVE SERIES-ID TO ASR-ID PERFORM SERVICE
    IF FUNCTION TRIM(ASO-CLIENT) = "Temporary client" ADD 1 TO FAILURES END-IF
    MOVE 0 TO AC-CANCEL-RETENTION
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "CANCEL" TO ASR-OPERATION MOVE CREATED-ID TO ASR-ID
    MOVE "single" TO ASR-SCOPE PERFORM SERVICE
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "DELETE" TO ASR-OPERATION MOVE CREATED-ID TO ASR-ID
    MOVE "DELETE" TO ASR-CONFIRM PERFORM SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK ADD 1 TO FAILURES END-IF
    DISPLAY "service tests failures=" FAILURES
    MOVE FAILURES TO RETURN-CODE GOBACK.
SERVICE.
    CALL "APPOINTMENT-SERVICE" USING APPOINTMENT-SERVICE-REQUEST
      APPOINTMENT-SERVICE-RESULT APPOINTMENT-CONFIG.
END PROGRAM TEST-SERVICE.
