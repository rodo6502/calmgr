>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. CALMGR-BATCH.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "appointment-status.cpy".
COPY "appointment-config.cpy".
COPY "appointment-service-request.cpy".
COPY "appointment-service-result.cpy".
01 WS-REQUEST-PATH         PIC X(256).
01 WS-RESPONSE-PATH        PIC X(256).
01 WS-ARG-NUMBER           PIC 9.
01 WS-ARG-COUNT            PIC 9.
01 WS-JSON-OP              PIC X(16).
01 WS-COMMAND              PIC X(24).
01 WS-STATUS               PIC 9(3).
01 WS-MESSAGE              PIC X(160).
01 WS-TOTAL                PIC 9(5).
01 WS-DONE                 PIC X.
01 WS-PATH-TALLY           PIC 99 COMP-5.
01 WS-USER-DATABASE        PIC X(256).
01 WS-USER-OPERATION       PIC X(24).
01 WS-USER-NAME            PIC X(64).
01 WS-USER-PASSWORD        PIC X(256).
01 WS-ACTOR-NAME           PIC X(64).
01 WS-ACTOR-PASSWORD       PIC X(256).
01 WS-USER-ROLE            PIC X(8).
01 WS-USER-CONFIRM         PIC X(16).
01 WS-NEW-PASSWORD         PIC X(256).
01 WS-USER-ID              PIC X(12).
01 WS-OUT-USERNAME         PIC X(64).
01 WS-OUT-ROLE             PIC X(8).
01 WS-OUT-ACTIVE           PIC X.
01 WS-OUT-REVISION         PIC 9(9).
01 WS-USER-STATUS          PIC 9(3).
01 WS-USER-MESSAGE         PIC X(160).
PROCEDURE DIVISION.
    ACCEPT WS-ARG-COUNT FROM ARGUMENT-NUMBER
    IF WS-ARG-COUNT NOT = 2
      DISPLAY "Usage: calmgr-batch REQUEST.json|- RESPONSE.json" UPON STDERR
      MOVE 2 TO RETURN-CODE
      GOBACK
    END-IF
    MOVE 1 TO WS-ARG-NUMBER
    DISPLAY WS-ARG-NUMBER UPON ARGUMENT-NUMBER
    ACCEPT WS-REQUEST-PATH FROM ARGUMENT-VALUE
    IF FUNCTION TRIM(WS-REQUEST-PATH) = "-"
      MOVE "@STDIN" TO WS-REQUEST-PATH
    END-IF
    MOVE 2 TO WS-ARG-NUMBER
    DISPLAY WS-ARG-NUMBER UPON ARGUMENT-NUMBER
    ACCEPT WS-RESPONSE-PATH FROM ARGUMENT-VALUE
    IF FUNCTION TRIM(WS-REQUEST-PATH) = FUNCTION TRIM(WS-RESPONSE-PATH)
      DISPLAY "Request and response paths must differ" UPON STDERR
      MOVE 2 TO RETURN-CODE
      GOBACK
    END-IF
    CALL "APPOINTMENT-CONFIG-ADAPTER" USING APPOINTMENT-CONFIG WS-STATUS WS-MESSAGE
    IF WS-STATUS NOT = APPT-OK
      DISPLAY FUNCTION TRIM(WS-MESSAGE) UPON STDERR
      MOVE 3 TO RETURN-CODE
      GOBACK
    END-IF
    IF FUNCTION TRIM(WS-RESPONSE-PATH) = FUNCTION TRIM(AC-DATA-FILE)
      OR FUNCTION TRIM(WS-RESPONSE-PATH) = FUNCTION TRIM(AC-BACKUP-FILE)
      OR FUNCTION TRIM(WS-RESPONSE-PATH) = FUNCTION TRIM(AC-SAFETY-FILE)
      OR FUNCTION TRIM(WS-RESPONSE-PATH) = FUNCTION TRIM(AC-AUDIT-FILE)
      OR FUNCTION TRIM(WS-RESPONSE-PATH) = FUNCTION TRIM(AC-PRINT-FILE)
      OR FUNCTION TRIM(WS-RESPONSE-PATH) = FUNCTION TRIM(AC-LIST-PRINT-FILE)
      OR FUNCTION TRIM(WS-RESPONSE-PATH) = FUNCTION TRIM(AC-CSV-FILE)
      OR FUNCTION TRIM(WS-RESPONSE-PATH) = FUNCTION TRIM(AC-ICAL-FILE)
      MOVE APPT-FORBIDDEN TO ASO-STATUS-CODE
      MOVE "Unsafe response path" TO ASO-MESSAGE
      PERFORM WRITE-SIMPLE-RESPONSE
      MOVE 2 TO RETURN-CODE
      GOBACK
    END-IF
    MOVE "READ" TO WS-JSON-OP
    CALL "APPOINTMENT-JSON" USING WS-JSON-OP WS-REQUEST-PATH WS-RESPONSE-PATH
      APPOINTMENT-SERVICE-REQUEST APPOINTMENT-SERVICE-RESULT
    IF ASO-STATUS-CODE NOT = APPT-OK
      PERFORM WRITE-SIMPLE-RESPONSE
      MOVE 2 TO RETURN-CODE
      GOBACK
    END-IF
    MOVE ASR-OPERATION TO WS-COMMAND
    IF ASR-SOURCE = SPACES MOVE "BATCH" TO ASR-SOURCE END-IF
    IF ASR-SCOPE = SPACES MOVE "single" TO ASR-SCOPE END-IF
    IF ASR-MODE = SPACES MOVE "all" TO ASR-MODE END-IF
    IF ASR-RECURRENCE = SPACE MOVE "N" TO ASR-RECURRENCE END-IF
    EVALUATE FUNCTION TRIM(WS-COMMAND)
      WHEN "LIST" PERFORM COMMAND-LIST
      WHEN "SHOW" MOVE "SHOW" TO ASR-OPERATION PERFORM COMMAND-ONE
      WHEN "ADD" MOVE "ADD" TO ASR-OPERATION PERFORM COMMAND-ONE
      WHEN "EDIT" MOVE "EDIT" TO ASR-OPERATION PERFORM COMMAND-ONE
      WHEN "CANCEL" MOVE "CANCEL" TO ASR-OPERATION PERFORM COMMAND-ONE
      WHEN "REACTIVATE" MOVE "REACTIVATE" TO ASR-OPERATION PERFORM COMMAND-ONE
      WHEN "DELETE" MOVE "DELETE" TO ASR-OPERATION PERFORM COMMAND-ONE
      WHEN "BACKUP" MOVE "BACKUP" TO ASR-OPERATION PERFORM COMMAND-ONE
      WHEN "RESTORE" MOVE "RESTORE" TO ASR-OPERATION PERFORM COMMAND-ONE
      WHEN "INIT" MOVE "INIT" TO ASR-OPERATION PERFORM COMMAND-ONE
      WHEN "RESET-DATABASE"
        MOVE "RESET-DATABASE" TO ASR-OPERATION PERFORM COMMAND-ONE
      WHEN "PRINT-EXPORT" MOVE "PRINT-EXPORT" TO ASR-OPERATION PERFORM COMMAND-ONE
      WHEN "PRINT-LIST-EXPORT"
        MOVE "PRINT-LIST-EXPORT" TO ASR-OPERATION PERFORM COMMAND-ONE
      WHEN "CSV-EXPORT" MOVE "CSV-EXPORT" TO ASR-OPERATION PERFORM COMMAND-ONE
      WHEN "ICAL-EXPORT" MOVE "ICAL-EXPORT" TO ASR-OPERATION PERFORM COMMAND-ONE
      WHEN "CSV-IMPORT" PERFORM COMMAND-CSV-IMPORT
      WHEN "USER-BOOTSTRAP" PERFORM COMMAND-USER
      WHEN "USER-ADD" PERFORM COMMAND-USER
      WHEN "USER-LIST" PERFORM COMMAND-USER-LIST
      WHEN "USER-PASSWORD" PERFORM COMMAND-USER
      WHEN "USER-DISABLE" PERFORM COMMAND-USER
      WHEN "USER-ENABLE" PERFORM COMMAND-USER
      WHEN "AUTH-LOGIN" PERFORM COMMAND-AUTH
      WHEN "AUTH-CHECK" PERFORM COMMAND-AUTH
      WHEN OTHER
        MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
        MOVE "Unsupported command" TO ASO-MESSAGE
        PERFORM WRITE-SIMPLE-RESPONSE
    END-EVALUATE
    IF ASO-STATUS-CODE = APPT-OK
      MOVE 0 TO RETURN-CODE
    ELSE IF ASO-STATUS-CODE >= 20
      MOVE 3 TO RETURN-CODE
    ELSE
      MOVE 2 TO RETURN-CODE
    END-IF
    END-IF
    GOBACK.

COMMAND-ONE.
    CALL "APPOINTMENT-SERVICE" USING APPOINTMENT-SERVICE-REQUEST
      APPOINTMENT-SERVICE-RESULT APPOINTMENT-CONFIG
    MOVE ASO-COUNT TO WS-TOTAL
    MOVE "OPEN" TO WS-JSON-OP
    CALL "APPOINTMENT-JSON" USING WS-JSON-OP WS-REQUEST-PATH WS-RESPONSE-PATH
      APPOINTMENT-SERVICE-REQUEST APPOINTMENT-SERVICE-RESULT
    IF ASO-STATUS-CODE = APPT-OK AND ASO-ID NOT = SPACES
      MOVE "ITEM" TO WS-JSON-OP
      CALL "APPOINTMENT-JSON" USING WS-JSON-OP WS-REQUEST-PATH WS-RESPONSE-PATH
        APPOINTMENT-SERVICE-REQUEST APPOINTMENT-SERVICE-RESULT
    END-IF
    MOVE "CLOSE" TO WS-JSON-OP
    CALL "APPOINTMENT-JSON" USING WS-JSON-OP WS-REQUEST-PATH WS-RESPONSE-PATH
      APPOINTMENT-SERVICE-REQUEST APPOINTMENT-SERVICE-RESULT.

COMMAND-LIST.
    MOVE 0 TO WS-TOTAL
    MOVE "LIST-OPEN" TO ASR-OPERATION
    CALL "APPOINTMENT-SERVICE" USING APPOINTMENT-SERVICE-REQUEST
      APPOINTMENT-SERVICE-RESULT APPOINTMENT-CONFIG
    IF ASO-STATUS-CODE = APPT-OK
      PERFORM UNTIL ASO-STATUS-CODE = APPT-NOT-FOUND
        MOVE "LIST-NEXT" TO ASR-OPERATION
        CALL "APPOINTMENT-SERVICE" USING APPOINTMENT-SERVICE-REQUEST
          APPOINTMENT-SERVICE-RESULT APPOINTMENT-CONFIG
        IF ASO-STATUS-CODE = APPT-OK ADD 1 TO WS-TOTAL END-IF
      END-PERFORM
      MOVE "LIST-CLOSE" TO ASR-OPERATION
      CALL "APPOINTMENT-SERVICE" USING APPOINTMENT-SERVICE-REQUEST
        APPOINTMENT-SERVICE-RESULT APPOINTMENT-CONFIG
      MOVE APPT-OK TO ASO-STATUS-CODE
      MOVE WS-TOTAL TO ASO-COUNT
      MOVE "Appointments listed" TO ASO-MESSAGE
    END-IF
    MOVE "OPEN" TO WS-JSON-OP
    CALL "APPOINTMENT-JSON" USING WS-JSON-OP WS-REQUEST-PATH WS-RESPONSE-PATH
      APPOINTMENT-SERVICE-REQUEST APPOINTMENT-SERVICE-RESULT
    IF ASO-STATUS-CODE = APPT-OK
      MOVE "LIST-OPEN" TO ASR-OPERATION
      CALL "APPOINTMENT-SERVICE" USING APPOINTMENT-SERVICE-REQUEST
        APPOINTMENT-SERVICE-RESULT APPOINTMENT-CONFIG
      PERFORM UNTIL ASO-STATUS-CODE = APPT-NOT-FOUND
        MOVE "LIST-NEXT" TO ASR-OPERATION
        CALL "APPOINTMENT-SERVICE" USING APPOINTMENT-SERVICE-REQUEST
          APPOINTMENT-SERVICE-RESULT APPOINTMENT-CONFIG
        IF ASO-STATUS-CODE = APPT-OK
          MOVE "ITEM" TO WS-JSON-OP
          CALL "APPOINTMENT-JSON" USING WS-JSON-OP WS-REQUEST-PATH WS-RESPONSE-PATH
            APPOINTMENT-SERVICE-REQUEST APPOINTMENT-SERVICE-RESULT
        END-IF
      END-PERFORM
      MOVE "LIST-CLOSE" TO ASR-OPERATION
      CALL "APPOINTMENT-SERVICE" USING APPOINTMENT-SERVICE-REQUEST
        APPOINTMENT-SERVICE-RESULT APPOINTMENT-CONFIG
      MOVE APPT-OK TO ASO-STATUS-CODE
    END-IF
    MOVE "CLOSE" TO WS-JSON-OP
    CALL "APPOINTMENT-JSON" USING WS-JSON-OP WS-REQUEST-PATH WS-RESPONSE-PATH
      APPOINTMENT-SERVICE-REQUEST APPOINTMENT-SERVICE-RESULT.

WRITE-SIMPLE-RESPONSE.
    MOVE "OPEN" TO WS-JSON-OP
    CALL "APPOINTMENT-JSON" USING WS-JSON-OP WS-REQUEST-PATH WS-RESPONSE-PATH
      APPOINTMENT-SERVICE-REQUEST APPOINTMENT-SERVICE-RESULT
    MOVE "CLOSE" TO WS-JSON-OP
    CALL "APPOINTMENT-JSON" USING WS-JSON-OP WS-REQUEST-PATH WS-RESPONSE-PATH
      APPOINTMENT-SERVICE-REQUEST APPOINTMENT-SERVICE-RESULT.

COMMAND-CSV-IMPORT.
    MOVE 0 TO WS-PATH-TALLY
    INSPECT ASR-PATH TALLYING WS-PATH-TALLY FOR ALL ".."
    IF WS-PATH-TALLY > 0 OR (ASR-PATH(1:8) NOT = "imports/"
      AND ASR-PATH(1:9) NOT = "examples/")
      MOVE APPT-FORBIDDEN TO ASO-STATUS-CODE
      MOVE "CSV imports are restricted to imports/ and examples/" TO ASO-MESSAGE
      PERFORM WRITE-SIMPLE-RESPONSE
    ELSE
      MOVE "CSV-IMPORT" TO ASR-OPERATION PERFORM COMMAND-ONE
    END-IF.

CALL-USER-ADAPTER.
    MOVE AC-DATA-FILE TO WS-USER-DATABASE
    MOVE ASR-OPERATION TO WS-USER-OPERATION
    MOVE ASR-USERNAME TO WS-USER-NAME
    MOVE ASR-PASSWORD TO WS-USER-PASSWORD
    MOVE ASR-ACTOR-USERNAME TO WS-ACTOR-NAME
    MOVE ASR-ACTOR-PASSWORD TO WS-ACTOR-PASSWORD
    MOVE ASR-ROLE TO WS-USER-ROLE
    MOVE ASR-CONFIRM TO WS-USER-CONFIRM
    MOVE ASR-NEW-PASSWORD TO WS-NEW-PASSWORD
    MOVE ASR-USER-ID TO WS-USER-ID
    CALL "appt_user_command" USING WS-USER-DATABASE WS-USER-OPERATION
      WS-USER-NAME WS-USER-PASSWORD WS-ACTOR-NAME WS-ACTOR-PASSWORD
      WS-USER-ROLE WS-USER-CONFIRM WS-NEW-PASSWORD WS-USER-ID
      WS-OUT-USERNAME WS-OUT-ROLE WS-OUT-ACTIVE WS-OUT-REVISION
      WS-USER-STATUS WS-USER-MESSAGE
    MOVE WS-USER-ID TO ASR-USER-ID ASO-USER-ID
    MOVE WS-OUT-USERNAME TO ASO-USERNAME
    MOVE WS-OUT-ROLE TO ASO-ROLE
    MOVE WS-OUT-ACTIVE TO ASO-USER-ACTIVE
    MOVE WS-OUT-REVISION TO ASO-USER-REVISION
    MOVE WS-USER-STATUS TO ASO-STATUS-CODE
    MOVE WS-USER-MESSAGE TO ASO-MESSAGE
    INITIALIZE ASR-PASSWORD ASR-ACTOR-PASSWORD ASR-NEW-PASSWORD
      WS-USER-PASSWORD WS-ACTOR-PASSWORD WS-NEW-PASSWORD.

COMMAND-USER.
    PERFORM CALL-USER-ADAPTER
    PERFORM WRITE-SIMPLE-RESPONSE.

COMMAND-AUTH.
    PERFORM CALL-USER-ADAPTER
    MOVE "AUTH" TO WS-JSON-OP
    CALL "APPOINTMENT-JSON" USING WS-JSON-OP WS-REQUEST-PATH WS-RESPONSE-PATH
      APPOINTMENT-SERVICE-REQUEST APPOINTMENT-SERVICE-RESULT.

COMMAND-USER-LIST.
    MOVE "USER-LIST-OPEN" TO ASR-OPERATION
    PERFORM CALL-USER-ADAPTER
    MOVE "USERS-OPEN" TO WS-JSON-OP
    CALL "APPOINTMENT-JSON" USING WS-JSON-OP WS-REQUEST-PATH WS-RESPONSE-PATH
      APPOINTMENT-SERVICE-REQUEST APPOINTMENT-SERVICE-RESULT
    IF ASO-STATUS-CODE = APPT-OK
      PERFORM UNTIL ASO-STATUS-CODE NOT = APPT-OK
        MOVE "USER-LIST-NEXT" TO ASR-OPERATION
        PERFORM CALL-USER-ADAPTER
        IF ASO-STATUS-CODE = APPT-OK
          MOVE "USER-ITEM" TO WS-JSON-OP
          CALL "APPOINTMENT-JSON" USING WS-JSON-OP WS-REQUEST-PATH
            WS-RESPONSE-PATH APPOINTMENT-SERVICE-REQUEST
            APPOINTMENT-SERVICE-RESULT
        END-IF
      END-PERFORM
      IF ASO-STATUS-CODE = APPT-NOT-FOUND
        MOVE APPT-OK TO ASO-STATUS-CODE
        MOVE "Users listed" TO ASO-MESSAGE
      END-IF
      MOVE "USER-LIST-CLOSE" TO ASR-OPERATION
      PERFORM CALL-USER-ADAPTER
    END-IF
    MOVE "USERS-CLOSE" TO WS-JSON-OP
    CALL "APPOINTMENT-JSON" USING WS-JSON-OP WS-REQUEST-PATH WS-RESPONSE-PATH
      APPOINTMENT-SERVICE-REQUEST APPOINTMENT-SERVICE-RESULT.
END PROGRAM CALMGR-BATCH.
