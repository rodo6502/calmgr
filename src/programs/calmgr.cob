>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. CALMGR.
ENVIRONMENT DIVISION.
CONFIGURATION SECTION.
SPECIAL-NAMES.
    CONSOLE IS CRT
    CRT STATUS IS TUI-CRT-STATUS.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "appointment-status.cpy".
COPY "appointment-config.cpy".
COPY "appointment-service-request.cpy".
COPY "appointment-service-result.cpy".
COPY "appointment-date-params.cpy".

01 TUI-CRT-STATUS              PIC 9(4) VALUE ZERO.
01 TUI-CHOICE                  PIC X VALUE SPACE.
01 TUI-PAUSE                   PIC X VALUE SPACE.
01 TUI-ID                      PIC X(9) VALUE SPACES.
01 TUI-STATUS                  PIC 9(3) VALUE ZERO.
01 TUI-MESSAGE                 PIC X(160) VALUE SPACES.
01 TUI-OP                      PIC X(12) VALUE SPACES.
01 TUI-SCREEN-DATA.
   05 TUI-SCREEN-TITLE         PIC X(80).
   05 TUI-SCREEN-PROMPT        PIC X(60).
   05 TUI-SCREEN-ERROR         PIC X(76).
   05 TUI-SCREEN-MESSAGE       PIC X(76).
   05 TUI-SCREEN-CONFIRM       PIC X.
   05 TUI-SCREEN-TOKEN         PIC X(16).
01 TUI-FORM-DATA.
   05 TUI-FORM-START           PIC X(10).
   05 TUI-FORM-END             PIC X(10).
   05 TUI-FORM-CLIENT          PIC X(60).
   05 TUI-FORM-SUBJECT-1       PIC X(60).
   05 TUI-FORM-SUBJECT-2       PIC X(40).
   05 TUI-FORM-RECURRENCE      PIC X.
   05 TUI-FORM-SERIES-UNTIL    PIC X(10).
01 TUI-SEARCH-DATA.
   05 TUI-SEARCH-TEXT          PIC X(55).
   05 TUI-SEARCH-FROM          PIC X(10).
   05 TUI-SEARCH-TO            PIC X(10).
   05 TUI-SEARCH-STATE         PIC X.
   05 TUI-SEARCH-SERIES        PIC X(9).
   05 TUI-SEARCH-SORT          PIC X.
01 TUI-LIST-DATA.
   05 TUI-LIST-PAGE            PIC 99 VALUE 1.
   05 TUI-LIST-PAGE-SIZE       PIC 99 VALUE 12.
   05 TUI-LIST-COUNT           PIC 99 VALUE ZERO.
   05 TUI-LIST-SKIP            PIC 9(4) VALUE ZERO.
   05 TUI-LIST-INDEX           PIC 99 VALUE ZERO.
   05 TUI-LIST-HAS-NEXT        PIC X VALUE "N".
   05 TUI-LIST-NAVIGATION      PIC X.
   05 TUI-SCREEN-LINE          PIC 99.
   05 TUI-SCREEN-ROW           PIC X(80).
   05 TUI-SCREEN-ROW-COLOR     PIC 9.
   05 TUI-LIST-ROWS OCCURS 12 TIMES.
      10 TUI-SAVED-ROW         PIC X(80).
      10 TUI-SAVED-COLOR       PIC 9.
01 TUI-SAVED-LIST-FILTER.
   05 TUI-SAVED-MODE           PIC X(12).
   05 TUI-SAVED-STATUS         PIC X.
   05 TUI-SAVED-SERIES-ID      PIC X(9).
   05 TUI-SAVED-QUERY          PIC X(100).
   05 TUI-SAVED-SORT           PIC X(12).
   05 TUI-SAVED-FROM-DATE      PIC 9(8).
   05 TUI-SAVED-TO-DATE        PIC 9(8).
01 TUI-RESULT-DATA.
   05 TUI-RESULT-TITLE         PIC X(80).
   05 TUI-RESULT-LINE-1        PIC X(72).
   05 TUI-RESULT-LINE-2        PIC X(72).
   05 TUI-RESULT-LINE-3        PIC X(72).
   05 TUI-RESULT-LINE-4        PIC X(72).
   05 TUI-RESULT-LINE-5        PIC X(72).
   05 TUI-RESULT-COLOR         PIC 9 VALUE 2.
01 TUI-DETAIL-DATA.
   05 TUI-DISPLAY-START        PIC X(10).
   05 TUI-DISPLAY-END          PIC X(10).
   05 TUI-DISPLAY-SERIES       PIC X(10).
   05 TUI-DISPLAY-CANCELLED    PIC X(10).
   05 TUI-DETAIL-STATUS        PIC X(12).
   05 TUI-DETAIL-COLOR         PIC 9.
   05 TUI-NOTE-1               PIC X(60).
   05 TUI-NOTE-2               PIC X(60).
01 TUI-ACTION-DATA.
   05 TUI-SERIES-SCOPE         PIC X.
   05 TUI-MAINTENANCE-ACTION   PIC X.
   05 TUI-YEAR-FIRST           PIC X(4).
   05 TUI-YEAR-LAST            PIC X(4).
   05 TUI-PRINT-CHOICE         PIC X.
01 TUI-DATE-WORK.
   05 TUI-DATE-TEXT            PIC X(10).
   05 TUI-DATE-NORMALIZED      PIC X(8).
   05 TUI-DATE-NUMBER          PIC 9(8).
   05 TUI-DATE-VALID           PIC X.
01 TUI-DIAGNOSTIC-DATA.
   05 TUI-DIAGNOSTIC-SUMMARY   PIC X(72).
   05 TUI-DIAGNOSTIC-LINE      PIC X(72).
   05 TUI-DIAGNOSTIC-COLOR     PIC 9.
   05 TUI-DIAGNOSTIC-PASSED    PIC 99.
   05 TUI-DIAGNOSTIC-FAILED    PIC 99.

SCREEN SECTION.
COPY "appointment-screens.cpy".

PROCEDURE DIVISION.
MAIN-PROCEDURE.
    CALL "APPOINTMENT-CONFIG-ADAPTER" USING APPOINTMENT-CONFIG
      TUI-STATUS TUI-MESSAGE
    IF TUI-STATUS NOT = APPT-OK
      MOVE "CONFIGURATION ERROR" TO TUI-RESULT-TITLE
      MOVE TUI-MESSAGE(1:72) TO TUI-RESULT-LINE-1
      MOVE 4 TO TUI-RESULT-COLOR
      PERFORM DISPLAY-RESULT-SCREEN
      MOVE 3 TO RETURN-CODE
      GOBACK
    END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "INIT" TO ASR-OPERATION
    MOVE "TUI" TO ASR-SOURCE
    PERFORM CALL-SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK
      PERFORM PREPARE-SERVICE-RESULT
      PERFORM DISPLAY-RESULT-SCREEN
      MOVE 3 TO RETURN-CODE
      GOBACK
    END-IF
    MOVE SPACE TO TUI-CHOICE
    PERFORM UNTIL TUI-CHOICE = "Q"
      PERFORM DISPLAY-MAIN-MENU
      EVALUATE TUI-CHOICE
        WHEN "C" PERFORM PREPARE-CURRENT-LIST
        WHEN "A" PERFORM PREPARE-ALL-LIST
        WHEN "N" PERFORM NEW-APPOINTMENT
        WHEN "E" PERFORM EDIT-APPOINTMENT
        WHEN "X" PERFORM CANCEL-APPOINTMENT
        WHEN "P" PERFORM PRINT-EXPORT
        WHEN "D" PERFORM RUN-DIAGNOSTICS
        WHEN "B" PERFORM BACKUP-DATA
        WHEN "R" PERFORM RESTORE-DATA
        WHEN "M" PERFORM MAINTAIN-CANCELLED
        WHEN "U" PERFORM PURGE-CANCELLED
        WHEN "S" PERFORM SEARCH-APPOINTMENTS
        WHEN "Q" CONTINUE
        WHEN OTHER CONTINUE
      END-EVALUATE
    END-PERFORM
    DISPLAY CLEAR-SCREEN
    GOBACK.

DISPLAY-MAIN-MENU.
    MOVE SPACE TO TUI-CHOICE
    MOVE ZERO TO TUI-CRT-STATUS
    ACCEPT MAIN-MENU-SCREEN
    MOVE FUNCTION UPPER-CASE(TUI-CHOICE) TO TUI-CHOICE
    IF TUI-CRT-STATUS = 2005 OR TUI-CRT-STATUS = 1012
      MOVE "Q" TO TUI-CHOICE
    END-IF.

PREPARE-CURRENT-LIST.
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "TUI" TO ASR-SOURCE
    MOVE "current" TO ASR-MODE
    MOVE "start" TO ASR-SORT
    MOVE "CURRENT APPOINTMENTS" TO TUI-SCREEN-TITLE
    MOVE 1 TO TUI-LIST-PAGE
    PERFORM SAVE-LIST-FILTER
    PERFORM DISPLAY-LIST.

PREPARE-ALL-LIST.
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "TUI" TO ASR-SOURCE
    MOVE "all" TO ASR-MODE
    MOVE "start" TO ASR-SORT
    MOVE "ALL APPOINTMENTS" TO TUI-SCREEN-TITLE
    MOVE 1 TO TUI-LIST-PAGE
    PERFORM SAVE-LIST-FILTER
    PERFORM DISPLAY-LIST.

SEARCH-APPOINTMENTS.
    INITIALIZE TUI-SEARCH-DATA TUI-SCREEN-ERROR
    MOVE "*" TO TUI-SEARCH-STATE
    MOVE "D" TO TUI-SEARCH-SORT
    MOVE ZERO TO TUI-CRT-STATUS
    ACCEPT SEARCH-FILTER-SCREEN
    IF TUI-CRT-STATUS = 2005 OR TUI-CRT-STATUS = 1012
      EXIT PARAGRAPH
    END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "TUI" TO ASR-SOURCE
    MOVE "all" TO ASR-MODE
    MOVE TUI-SEARCH-TEXT TO ASR-QUERY
    IF FUNCTION UPPER-CASE(TUI-SEARCH-STATE) = "A"
      MOVE "A" TO ASR-STATUS
    ELSE IF FUNCTION UPPER-CASE(TUI-SEARCH-STATE) = "C"
      MOVE "C" TO ASR-STATUS
    END-IF
    MOVE TUI-SEARCH-SERIES TO ASR-SERIES-ID
    EVALUATE FUNCTION UPPER-CASE(TUI-SEARCH-SORT)
      WHEN "C" MOVE "client" TO ASR-SORT
      WHEN "S" MOVE "subject" TO ASR-SORT
      WHEN "I" MOVE "id" TO ASR-SORT
      WHEN OTHER MOVE "start" TO ASR-SORT
    END-EVALUATE
    IF TUI-SEARCH-FROM NOT = SPACES
      MOVE TUI-SEARCH-FROM TO TUI-DATE-TEXT
      PERFORM PARSE-SCREEN-DATE
      IF TUI-DATE-VALID NOT = "Y"
        MOVE "Invalid from date. Use DD.MM.YYYY." TO TUI-SCREEN-ERROR
        PERFORM SHOW-INPUT-ERROR
        EXIT PARAGRAPH
      END-IF
      MOVE TUI-DATE-NUMBER TO ASR-FROM-DATE
    END-IF
    IF TUI-SEARCH-TO NOT = SPACES
      MOVE TUI-SEARCH-TO TO TUI-DATE-TEXT
      PERFORM PARSE-SCREEN-DATE
      IF TUI-DATE-VALID NOT = "Y"
        MOVE "Invalid through date. Use DD.MM.YYYY." TO TUI-SCREEN-ERROR
        PERFORM SHOW-INPUT-ERROR
        EXIT PARAGRAPH
      END-IF
      MOVE TUI-DATE-NUMBER TO ASR-TO-DATE
    END-IF
    MOVE "SEARCH RESULTS" TO TUI-SCREEN-TITLE
    MOVE 1 TO TUI-LIST-PAGE
    PERFORM SAVE-LIST-FILTER
    PERFORM DISPLAY-LIST.

DISPLAY-LIST.
    MOVE SPACE TO TUI-LIST-NAVIGATION
    PERFORM UNTIL TUI-LIST-NAVIGATION = "Q"
      PERFORM LOAD-LIST-PAGE
      IF ASO-STATUS-CODE NOT = APPT-OK
        PERFORM PREPARE-SERVICE-RESULT
        PERFORM DISPLAY-RESULT-SCREEN
        EXIT PERFORM
      END-IF
      DISPLAY LIST-HEADER-SCREEN
      PERFORM VARYING TUI-LIST-INDEX FROM 1 BY 1
        UNTIL TUI-LIST-INDEX > TUI-LIST-COUNT
        COMPUTE TUI-SCREEN-LINE = TUI-LIST-INDEX + 4
        MOVE TUI-SAVED-ROW(TUI-LIST-INDEX) TO TUI-SCREEN-ROW
        MOVE TUI-SAVED-COLOR(TUI-LIST-INDEX) TO TUI-SCREEN-ROW-COLOR
        DISPLAY LIST-ROW-SCREEN
      END-PERFORM
      MOVE SPACE TO TUI-LIST-NAVIGATION
      MOVE ZERO TO TUI-CRT-STATUS
      ACCEPT LIST-NAVIGATION-SCREEN
      MOVE FUNCTION UPPER-CASE(TUI-LIST-NAVIGATION)
        TO TUI-LIST-NAVIGATION
      IF TUI-CRT-STATUS = 2005 OR TUI-CRT-STATUS = 1012
        MOVE "Q" TO TUI-LIST-NAVIGATION
      END-IF
      EVALUATE TUI-LIST-NAVIGATION
        WHEN "N"
          IF TUI-LIST-HAS-NEXT = "Y" ADD 1 TO TUI-LIST-PAGE END-IF
        WHEN "P"
          IF TUI-LIST-PAGE > 1 SUBTRACT 1 FROM TUI-LIST-PAGE END-IF
        WHEN "V"
          PERFORM VIEW-APPOINTMENT
        WHEN "Q" CONTINUE
        WHEN OTHER CONTINUE
      END-EVALUATE
    END-PERFORM.

LOAD-LIST-PAGE.
    PERFORM VARYING TUI-LIST-INDEX FROM 1 BY 1
      UNTIL TUI-LIST-INDEX > TUI-LIST-PAGE-SIZE
      INITIALIZE TUI-LIST-ROWS(TUI-LIST-INDEX)
    END-PERFORM
    MOVE ZERO TO TUI-LIST-COUNT
    MOVE "N" TO TUI-LIST-HAS-NEXT
    COMPUTE TUI-LIST-SKIP = (TUI-LIST-PAGE - 1) * TUI-LIST-PAGE-SIZE
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "TUI" TO ASR-SOURCE
    MOVE TUI-SAVED-MODE TO ASR-MODE
    MOVE TUI-SAVED-STATUS TO ASR-STATUS
    MOVE TUI-SAVED-SERIES-ID TO ASR-SERIES-ID
    MOVE TUI-SAVED-QUERY TO ASR-QUERY
    MOVE TUI-SAVED-SORT TO ASR-SORT
    MOVE TUI-SAVED-FROM-DATE TO ASR-FROM-DATE
    MOVE TUI-SAVED-TO-DATE TO ASR-TO-DATE
    MOVE "LIST-OPEN" TO ASR-OPERATION
    PERFORM CALL-SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    PERFORM VARYING TUI-LIST-INDEX FROM 1 BY 1
      UNTIL TUI-LIST-INDEX > TUI-LIST-SKIP
      MOVE "LIST-NEXT" TO ASR-OPERATION
      PERFORM CALL-SERVICE
      IF ASO-STATUS-CODE NOT = APPT-OK EXIT PERFORM END-IF
    END-PERFORM
    IF ASO-STATUS-CODE = APPT-NOT-FOUND
      MOVE APPT-OK TO ASO-STATUS-CODE
    END-IF
    PERFORM VARYING TUI-LIST-INDEX FROM 1 BY 1
      UNTIL TUI-LIST-INDEX > TUI-LIST-PAGE-SIZE
        OR ASO-STATUS-CODE NOT = APPT-OK
      MOVE "LIST-NEXT" TO ASR-OPERATION
      PERFORM CALL-SERVICE
      IF ASO-STATUS-CODE = APPT-OK
        ADD 1 TO TUI-LIST-COUNT
        PERFORM FORMAT-LIST-ROW
        MOVE TUI-SCREEN-ROW TO TUI-SAVED-ROW(TUI-LIST-COUNT)
        MOVE TUI-SCREEN-ROW-COLOR TO TUI-SAVED-COLOR(TUI-LIST-COUNT)
      END-IF
    END-PERFORM
    IF ASO-STATUS-CODE = APPT-OK
      MOVE "LIST-NEXT" TO ASR-OPERATION
      PERFORM CALL-SERVICE
      IF ASO-STATUS-CODE = APPT-OK MOVE "Y" TO TUI-LIST-HAS-NEXT END-IF
    END-IF
    MOVE "LIST-CLOSE" TO ASR-OPERATION
    PERFORM CALL-SERVICE
    MOVE APPT-OK TO ASO-STATUS-CODE
    INITIALIZE TUI-SCREEN-MESSAGE
    STRING "Page " TUI-LIST-PAGE
      ", " TUI-LIST-COUNT " appointment(s) shown"
      INTO TUI-SCREEN-MESSAGE
    END-STRING.

SAVE-LIST-FILTER.
    INITIALIZE TUI-SAVED-LIST-FILTER
    MOVE ASR-MODE TO TUI-SAVED-MODE
    MOVE ASR-STATUS TO TUI-SAVED-STATUS
    MOVE ASR-SERIES-ID TO TUI-SAVED-SERIES-ID
    MOVE ASR-QUERY TO TUI-SAVED-QUERY
    MOVE ASR-SORT TO TUI-SAVED-SORT
    MOVE ASR-FROM-DATE TO TUI-SAVED-FROM-DATE
    MOVE ASR-TO-DATE TO TUI-SAVED-TO-DATE.

FORMAT-LIST-ROW.
    INITIALIZE TUI-SCREEN-ROW
    MOVE ASO-START-DATE TO TUI-DATE-NUMBER
    PERFORM FORMAT-SCREEN-DATE
    MOVE TUI-DATE-TEXT TO TUI-DISPLAY-START
    MOVE ASO-END-DATE TO TUI-DATE-NUMBER
    PERFORM FORMAT-SCREEN-DATE
    MOVE TUI-DATE-TEXT TO TUI-DISPLAY-END
    STRING ASO-ID DELIMITED BY SIZE " "
      ASO-STATUS DELIMITED BY SIZE "  "
      TUI-DISPLAY-START DELIMITED BY SIZE " "
      TUI-DISPLAY-END DELIMITED BY SIZE " "
      ASO-ISO-WEEK DELIMITED BY SIZE "/" ASO-ISO-YEAR DELIMITED BY SIZE " "
      ASO-CLIENT(1:13) DELIMITED BY SIZE " "
      ASO-SUBJECT(1:16) DELIMITED BY SIZE
      INTO TUI-SCREEN-ROW
    END-STRING
    IF ASO-STATUS = "C" MOVE 4 TO TUI-SCREEN-ROW-COLOR
      ELSE MOVE 7 TO TUI-SCREEN-ROW-COLOR END-IF.

NEW-APPOINTMENT.
    INITIALIZE TUI-FORM-DATA TUI-SCREEN-ERROR
    MOVE "NEW APPOINTMENT" TO TUI-SCREEN-TITLE
    MOVE "N" TO TUI-FORM-RECURRENCE
    MOVE ZERO TO TUI-CRT-STATUS
    ACCEPT APPOINTMENT-FORM-SCREEN
    IF TUI-CRT-STATUS = 2005 OR TUI-CRT-STATUS = 1012
      EXIT PARAGRAPH
    END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "ADD" TO ASR-OPERATION
    MOVE "TUI" TO ASR-SOURCE
    PERFORM MOVE-FORM-TO-REQUEST
    IF TUI-DATE-VALID NOT = "Y" EXIT PARAGRAPH END-IF
    PERFORM CALL-SERVICE
    PERFORM PREPARE-SERVICE-RESULT
    PERFORM DISPLAY-RESULT-SCREEN.

VIEW-APPOINTMENT.
    MOVE "APPOINTMENT DETAILS" TO TUI-SCREEN-TITLE
    MOVE "Enter the appointment ID to display." TO TUI-SCREEN-PROMPT
    PERFORM ACCEPT-ID
    IF TUI-DATE-VALID NOT = "Y" EXIT PARAGRAPH END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "SHOW" TO ASR-OPERATION
    MOVE TUI-ID TO ASR-ID
    MOVE "TUI" TO ASR-SOURCE
    PERFORM CALL-SERVICE
    IF ASO-STATUS-CODE NOT = APPT-OK
      PERFORM PREPARE-SERVICE-RESULT
      PERFORM DISPLAY-RESULT-SCREEN
      EXIT PARAGRAPH
    END-IF
    PERFORM PREPARE-DETAIL
    MOVE SPACE TO TUI-PAUSE
    ACCEPT DETAIL-SCREEN.

EDIT-APPOINTMENT.
    MOVE "EDIT APPOINTMENT" TO TUI-SCREEN-TITLE
    MOVE "Enter the appointment ID to edit." TO TUI-SCREEN-PROMPT
    PERFORM ACCEPT-ID
    IF TUI-DATE-VALID NOT = "Y" EXIT PARAGRAPH END-IF
    PERFORM LOAD-APPOINTMENT
    IF ASO-STATUS-CODE NOT = APPT-OK
      PERFORM PREPARE-SERVICE-RESULT
      PERFORM DISPLAY-RESULT-SCREEN
      EXIT PARAGRAPH
    END-IF
    PERFORM PREPARE-FORM-FROM-RESULT
    MOVE ZERO TO TUI-CRT-STATUS
    ACCEPT APPOINTMENT-FORM-SCREEN
    IF TUI-CRT-STATUS = 2005 OR TUI-CRT-STATUS = 1012
      EXIT PARAGRAPH
    END-IF
    MOVE "O" TO TUI-SERIES-SCOPE
    IF ASO-SERIES-ID NOT = ZEROES AND ASO-SERIES-ID NOT = SPACES
      MOVE "EDIT RECURRING SERIES" TO TUI-SCREEN-TITLE
      ACCEPT SERIES-SCOPE-SCREEN
      IF TUI-CRT-STATUS = 2005 OR TUI-CRT-STATUS = 1012
        EXIT PARAGRAPH
      END-IF
    END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "EDIT" TO ASR-OPERATION
    MOVE TUI-ID TO ASR-ID
    MOVE "TUI" TO ASR-SOURCE
    PERFORM MAP-SERIES-SCOPE
    PERFORM MOVE-FORM-TO-REQUEST
    IF TUI-DATE-VALID NOT = "Y" EXIT PARAGRAPH END-IF
    PERFORM CALL-SERVICE
    PERFORM PREPARE-SERVICE-RESULT
    PERFORM DISPLAY-RESULT-SCREEN.

CANCEL-APPOINTMENT.
    MOVE "CANCEL APPOINTMENT" TO TUI-SCREEN-TITLE
    MOVE "Enter the appointment ID to cancel." TO TUI-SCREEN-PROMPT
    PERFORM ACCEPT-ID
    IF TUI-DATE-VALID NOT = "Y" EXIT PARAGRAPH END-IF
    PERFORM LOAD-APPOINTMENT
    IF ASO-STATUS-CODE NOT = APPT-OK
      PERFORM PREPARE-SERVICE-RESULT
      PERFORM DISPLAY-RESULT-SCREEN
      EXIT PARAGRAPH
    END-IF
    MOVE "O" TO TUI-SERIES-SCOPE
    IF ASO-SERIES-ID NOT = ZEROES AND ASO-SERIES-ID NOT = SPACES
      MOVE "CANCEL RECURRING SERIES" TO TUI-SCREEN-TITLE
      ACCEPT SERIES-SCOPE-SCREEN
      IF TUI-CRT-STATUS = 2005 OR TUI-CRT-STATUS = 1012
        EXIT PARAGRAPH
      END-IF
    END-IF
    INITIALIZE TUI-NOTE-1 TUI-NOTE-2
    MOVE "CANCEL APPOINTMENT" TO TUI-SCREEN-TITLE
    ACCEPT CANCEL-NOTE-SCREEN
    IF TUI-CRT-STATUS = 2005 OR TUI-CRT-STATUS = 1012
      EXIT PARAGRAPH
    END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "CANCEL" TO ASR-OPERATION
    MOVE TUI-ID TO ASR-ID
    MOVE "TUI" TO ASR-SOURCE
    PERFORM MAP-SERIES-SCOPE
    STRING TUI-NOTE-1 TUI-NOTE-2 INTO ASR-CANCEL-NOTE END-STRING
    PERFORM CALL-SERVICE
    PERFORM PREPARE-SERVICE-RESULT
    PERFORM DISPLAY-RESULT-SCREEN.

MAINTAIN-CANCELLED.
    MOVE "CANCELLED APPOINTMENT MAINTENANCE" TO TUI-SCREEN-TITLE
    MOVE "Enter the cancelled appointment ID." TO TUI-SCREEN-PROMPT
    PERFORM ACCEPT-ID
    IF TUI-DATE-VALID NOT = "Y" EXIT PARAGRAPH END-IF
    PERFORM LOAD-APPOINTMENT
    IF ASO-STATUS-CODE NOT = APPT-OK
      PERFORM PREPARE-SERVICE-RESULT
      PERFORM DISPLAY-RESULT-SCREEN
      EXIT PARAGRAPH
    END-IF
    MOVE SPACE TO TUI-MAINTENANCE-ACTION
    ACCEPT MAINTENANCE-SCREEN
    MOVE FUNCTION UPPER-CASE(TUI-MAINTENANCE-ACTION)
      TO TUI-MAINTENANCE-ACTION
    EVALUATE TUI-MAINTENANCE-ACTION
      WHEN "R" PERFORM REACTIVATE-APPOINTMENT
      WHEN "D" PERFORM DELETE-APPOINTMENT
      WHEN OTHER CONTINUE
    END-EVALUATE.

REACTIVATE-APPOINTMENT.
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "REACTIVATE" TO ASR-OPERATION
    MOVE TUI-ID TO ASR-ID
    MOVE "TUI" TO ASR-SOURCE
    PERFORM CALL-SERVICE
    PERFORM PREPARE-SERVICE-RESULT
    PERFORM DISPLAY-RESULT-SCREEN.

DELETE-APPOINTMENT.
    INITIALIZE TUI-SCREEN-TOKEN
    MOVE "PERMANENT DELETE" TO TUI-SCREEN-TITLE
    MOVE "Type DELETE to permanently remove this cancelled record."
      TO TUI-SCREEN-PROMPT
    ACCEPT TOKEN-CONFIRMATION-SCREEN
    IF FUNCTION UPPER-CASE(FUNCTION TRIM(TUI-SCREEN-TOKEN)) NOT = "DELETE"
      EXIT PARAGRAPH
    END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "DELETE" TO ASR-OPERATION
    MOVE TUI-ID TO ASR-ID
    MOVE "DELETE" TO ASR-CONFIRM
    MOVE "TUI" TO ASR-SOURCE
    PERFORM CALL-SERVICE
    PERFORM PREPARE-SERVICE-RESULT
    PERFORM DISPLAY-RESULT-SCREEN.

PURGE-CANCELLED.
    INITIALIZE TUI-SCREEN-TOKEN
    MOVE "PURGE CANCELLED APPOINTMENTS" TO TUI-SCREEN-TITLE
    MOVE "Type DELETE ALL to remove eligible cancelled records."
      TO TUI-SCREEN-PROMPT
    ACCEPT TOKEN-CONFIRMATION-SCREEN
    IF FUNCTION UPPER-CASE(FUNCTION TRIM(TUI-SCREEN-TOKEN)) NOT = "DELETE ALL"
      EXIT PARAGRAPH
    END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "PURGE" TO ASR-OPERATION
    MOVE "DELETE ALL" TO ASR-CONFIRM
    MOVE "TUI" TO ASR-SOURCE
    PERFORM CALL-SERVICE
    PERFORM PREPARE-SERVICE-RESULT
    PERFORM DISPLAY-RESULT-SCREEN.

BACKUP-DATA.
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "BACKUP" TO ASR-OPERATION
    MOVE "TUI" TO ASR-SOURCE
    PERFORM CALL-SERVICE
    PERFORM PREPARE-SERVICE-RESULT
    PERFORM DISPLAY-RESULT-SCREEN.

RESTORE-DATA.
    INITIALIZE TUI-SCREEN-CONFIRM
    MOVE "Restore the latest backup and replace live data?"
      TO TUI-SCREEN-PROMPT
    DISPLAY CLEAR-SCREEN
    ACCEPT CONFIRMATION-SCREEN
    IF FUNCTION UPPER-CASE(TUI-SCREEN-CONFIRM) NOT = "Y"
      EXIT PARAGRAPH
    END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "RESTORE" TO ASR-OPERATION
    MOVE "RESTORE" TO ASR-CONFIRM
    MOVE "TUI" TO ASR-SOURCE
    PERFORM CALL-SERVICE
    PERFORM PREPARE-SERVICE-RESULT
    PERFORM DISPLAY-RESULT-SCREEN.

PRINT-EXPORT.
    INITIALIZE TUI-YEAR-FIRST TUI-YEAR-LAST TUI-SCREEN-ERROR TUI-RESULT-DATA
      TUI-PRINT-CHOICE
    MOVE ZERO TO TUI-CRT-STATUS
    ACCEPT PRINT-EXPORT-CHOICE-SCREEN
    IF TUI-CRT-STATUS = 2005 OR TUI-CRT-STATUS = 1012
      EXIT PARAGRAPH
    END-IF
    MOVE FUNCTION UPPER-CASE(TUI-PRINT-CHOICE) TO TUI-PRINT-CHOICE
    IF TUI-PRINT-CHOICE NOT = "C" AND TUI-PRINT-CHOICE NOT = "L"
      EXIT PARAGRAPH
    END-IF
    ACCEPT EXPORT-FORM-SCREEN
    IF TUI-CRT-STATUS = 2005 OR TUI-CRT-STATUS = 1012
      EXIT PARAGRAPH
    END-IF
    IF TUI-YEAR-FIRST NOT NUMERIC OR TUI-YEAR-LAST NOT NUMERIC
      MOVE "Both years must contain four digits." TO TUI-RESULT-LINE-1
      MOVE "EXPORT INPUT ERROR" TO TUI-RESULT-TITLE
      MOVE 4 TO TUI-RESULT-COLOR
      PERFORM DISPLAY-RESULT-SCREEN
      EXIT PARAGRAPH
    END-IF
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    IF TUI-PRINT-CHOICE = "L"
      MOVE "PRINT-LIST-EXPORT" TO ASR-OPERATION
    ELSE
      MOVE "PRINT-EXPORT" TO ASR-OPERATION
    END-IF
    MOVE "TUI" TO ASR-SOURCE
    MOVE TUI-YEAR-FIRST TO ASR-FROM-DATE(1:4)
    MOVE "0101" TO ASR-FROM-DATE(5:4)
    MOVE TUI-YEAR-LAST TO ASR-TO-DATE(1:4)
    MOVE "1231" TO ASR-TO-DATE(5:4)
    PERFORM CALL-SERVICE
    PERFORM PREPARE-SERVICE-RESULT
    PERFORM DISPLAY-RESULT-SCREEN.

RUN-DIAGNOSTICS.
    INITIALIZE TUI-DIAGNOSTIC-PASSED TUI-DIAGNOSTIC-FAILED
      TUI-DIAGNOSTIC-SUMMARY
    DISPLAY DIAGNOSTIC-HEADER-SCREEN
    INITIALIZE APPOINTMENT-DATE-PARAMS
    MOVE 20240229 TO ADP-INPUT-DATE
    MOVE "VALIDATE" TO TUI-OP
    CALL "APPOINTMENT-DATES" USING TUI-OP APPOINTMENT-DATE-PARAMS TUI-STATUS
    MOVE 4 TO TUI-SCREEN-LINE
    MOVE "Leap day validation" TO TUI-DIAGNOSTIC-LINE
    IF TUI-STATUS = APPT-OK PERFORM DIAGNOSTIC-PASS
      ELSE PERFORM DIAGNOSTIC-FAIL END-IF
    INITIALIZE APPOINTMENT-DATE-PARAMS
    MOVE 20201231 TO ADP-INPUT-DATE
    MOVE "ISO" TO TUI-OP
    CALL "APPOINTMENT-DATES" USING TUI-OP APPOINTMENT-DATE-PARAMS TUI-STATUS
    MOVE 6 TO TUI-SCREEN-LINE
    MOVE "ISO year boundary (2020-W53)" TO TUI-DIAGNOSTIC-LINE
    IF ADP-ISO-YEAR = 2020 AND ADP-ISO-WEEK = 53
      PERFORM DIAGNOSTIC-PASS ELSE PERFORM DIAGNOSTIC-FAIL END-IF
    INITIALIZE APPOINTMENT-DATE-PARAMS
    MOVE 20240131 TO ADP-INPUT-DATE
    MOVE "M" TO ADP-RECURRENCE
    MOVE 31 TO ADP-ANCHOR-DAY
    CALL "APPOINTMENT-RECURRENCE" USING APPOINTMENT-DATE-PARAMS TUI-STATUS
    MOVE 8 TO TUI-SCREEN-LINE
    MOVE "Monthly recurrence clamps to leap-day" TO TUI-DIAGNOSTIC-LINE
    IF ADP-OUTPUT-DATE = 20240229
      PERFORM DIAGNOSTIC-PASS ELSE PERFORM DIAGNOSTIC-FAIL END-IF
    STRING TUI-DIAGNOSTIC-PASSED " passed, "
      TUI-DIAGNOSTIC-FAILED " failed"
      INTO TUI-DIAGNOSTIC-SUMMARY
    END-STRING
    DISPLAY DIAGNOSTIC-SUMMARY-SCREEN
    MOVE SPACE TO TUI-PAUSE
    ACCEPT DIAGNOSTIC-PAUSE-SCREEN.

DIAGNOSTIC-PASS.
    ADD 1 TO TUI-DIAGNOSTIC-PASSED
    MOVE 2 TO TUI-DIAGNOSTIC-COLOR
    MOVE TUI-DIAGNOSTIC-LINE TO TUI-MESSAGE
    INITIALIZE TUI-DIAGNOSTIC-LINE
    STRING "PASS  " FUNCTION TRIM(TUI-MESSAGE)
      INTO TUI-DIAGNOSTIC-LINE
    END-STRING
    DISPLAY DIAGNOSTIC-ROW-SCREEN.

DIAGNOSTIC-FAIL.
    ADD 1 TO TUI-DIAGNOSTIC-FAILED
    MOVE 4 TO TUI-DIAGNOSTIC-COLOR
    MOVE TUI-DIAGNOSTIC-LINE TO TUI-MESSAGE
    INITIALIZE TUI-DIAGNOSTIC-LINE
    STRING "FAIL  " FUNCTION TRIM(TUI-MESSAGE)
      INTO TUI-DIAGNOSTIC-LINE
    END-STRING
    DISPLAY DIAGNOSTIC-ROW-SCREEN.

ACCEPT-ID.
    INITIALIZE TUI-ID TUI-SCREEN-ERROR
    MOVE ZERO TO TUI-CRT-STATUS
    ACCEPT ID-ENTRY-SCREEN
    MOVE "N" TO TUI-DATE-VALID
    IF TUI-CRT-STATUS = 2005 OR TUI-CRT-STATUS = 1012
      EXIT PARAGRAPH
    END-IF
    IF TUI-ID NUMERIC MOVE "Y" TO TUI-DATE-VALID END-IF.

LOAD-APPOINTMENT.
    INITIALIZE APPOINTMENT-SERVICE-REQUEST
    MOVE "SHOW" TO ASR-OPERATION
    MOVE TUI-ID TO ASR-ID
    MOVE "TUI" TO ASR-SOURCE
    PERFORM CALL-SERVICE.

MOVE-FORM-TO-REQUEST.
    MOVE TUI-FORM-START TO TUI-DATE-TEXT
    PERFORM PARSE-SCREEN-DATE
    IF TUI-DATE-VALID NOT = "Y"
      MOVE "Invalid start date. Use DD.MM.YYYY."
        TO TUI-SCREEN-ERROR
      PERFORM SHOW-INPUT-ERROR
      EXIT PARAGRAPH
    END-IF
    MOVE TUI-DATE-NUMBER TO ASR-START-DATE
    MOVE TUI-FORM-END TO TUI-DATE-TEXT
    PERFORM PARSE-SCREEN-DATE
    IF TUI-DATE-VALID NOT = "Y"
      MOVE "Invalid end date. Use DD.MM.YYYY."
        TO TUI-SCREEN-ERROR
      PERFORM SHOW-INPUT-ERROR
      EXIT PARAGRAPH
    END-IF
    MOVE TUI-DATE-NUMBER TO ASR-END-DATE
    MOVE TUI-FORM-CLIENT TO ASR-CLIENT
    STRING TUI-FORM-SUBJECT-1 TUI-FORM-SUBJECT-2
      INTO ASR-SUBJECT
    END-STRING
    MOVE FUNCTION UPPER-CASE(TUI-FORM-RECURRENCE) TO ASR-RECURRENCE
    IF ASR-RECURRENCE = SPACE MOVE "N" TO ASR-RECURRENCE END-IF
    IF ASR-RECURRENCE NOT = "N" AND TUI-FORM-SERIES-UNTIL NOT = SPACES
      MOVE TUI-FORM-SERIES-UNTIL TO TUI-DATE-TEXT
      PERFORM PARSE-SCREEN-DATE
      IF TUI-DATE-VALID NOT = "Y"
        MOVE "Invalid series-through date. Use DD.MM.YYYY."
          TO TUI-SCREEN-ERROR
        PERFORM SHOW-INPUT-ERROR
        EXIT PARAGRAPH
      END-IF
      MOVE TUI-DATE-NUMBER TO ASR-SERIES-UNTIL
    END-IF
    MOVE "Y" TO TUI-DATE-VALID.

MAP-SERIES-SCOPE.
    EVALUATE FUNCTION UPPER-CASE(TUI-SERIES-SCOPE)
      WHEN "A" MOVE "series" TO ASR-SCOPE
      WHEN "F" MOVE "following" TO ASR-SCOPE
      WHEN OTHER MOVE "single" TO ASR-SCOPE
    END-EVALUATE.

PREPARE-FORM-FROM-RESULT.
    INITIALIZE TUI-FORM-DATA TUI-SCREEN-ERROR
    MOVE ASO-START-DATE TO TUI-DATE-NUMBER
    PERFORM FORMAT-SCREEN-DATE
    MOVE TUI-DATE-TEXT TO TUI-FORM-START
    MOVE ASO-END-DATE TO TUI-DATE-NUMBER
    PERFORM FORMAT-SCREEN-DATE
    MOVE TUI-DATE-TEXT TO TUI-FORM-END
    MOVE ASO-CLIENT TO TUI-FORM-CLIENT
    MOVE ASO-SUBJECT(1:60) TO TUI-FORM-SUBJECT-1
    MOVE ASO-SUBJECT(61:40) TO TUI-FORM-SUBJECT-2
    MOVE ASO-RECURRENCE TO TUI-FORM-RECURRENCE
    IF ASO-SERIES-UNTIL > ZERO
      MOVE ASO-SERIES-UNTIL TO TUI-DATE-NUMBER
      PERFORM FORMAT-SCREEN-DATE
      MOVE TUI-DATE-TEXT TO TUI-FORM-SERIES-UNTIL
    END-IF.

PREPARE-DETAIL.
    MOVE "APPOINTMENT DETAILS" TO TUI-SCREEN-TITLE
    MOVE ASO-START-DATE TO TUI-DATE-NUMBER
    PERFORM FORMAT-SCREEN-DATE
    MOVE TUI-DATE-TEXT TO TUI-DISPLAY-START
    MOVE ASO-END-DATE TO TUI-DATE-NUMBER
    PERFORM FORMAT-SCREEN-DATE
    MOVE TUI-DATE-TEXT TO TUI-DISPLAY-END
    INITIALIZE TUI-DISPLAY-SERIES TUI-DISPLAY-CANCELLED
      TUI-NOTE-1 TUI-NOTE-2
    IF ASO-SERIES-UNTIL > ZERO
      MOVE ASO-SERIES-UNTIL TO TUI-DATE-NUMBER
      PERFORM FORMAT-SCREEN-DATE
      MOVE TUI-DATE-TEXT TO TUI-DISPLAY-SERIES
    END-IF
    IF ASO-CANCELLED-ON > ZERO
      MOVE ASO-CANCELLED-ON TO TUI-DATE-NUMBER
      PERFORM FORMAT-SCREEN-DATE
      MOVE TUI-DATE-TEXT TO TUI-DISPLAY-CANCELLED
    END-IF
    MOVE ASO-SUBJECT(1:60) TO TUI-FORM-SUBJECT-1
    MOVE ASO-SUBJECT(61:40) TO TUI-FORM-SUBJECT-2
    MOVE ASO-CANCEL-NOTE(1:60) TO TUI-NOTE-1
    MOVE ASO-CANCEL-NOTE(61:60) TO TUI-NOTE-2
    IF ASO-STATUS = "C"
      MOVE "CANCELLED" TO TUI-DETAIL-STATUS
      MOVE 4 TO TUI-DETAIL-COLOR
    ELSE
      MOVE "ACTIVE" TO TUI-DETAIL-STATUS
      MOVE 2 TO TUI-DETAIL-COLOR
    END-IF.

PARSE-SCREEN-DATE.
    MOVE "N" TO TUI-DATE-VALID
    INITIALIZE TUI-DATE-NORMALIZED TUI-DATE-NUMBER
    IF TUI-DATE-TEXT(3:1) = "." AND TUI-DATE-TEXT(6:1) = "."
      STRING TUI-DATE-TEXT(7:4) TUI-DATE-TEXT(4:2) TUI-DATE-TEXT(1:2)
        INTO TUI-DATE-NORMALIZED
      END-STRING
      IF TUI-DATE-NORMALIZED NUMERIC
        MOVE TUI-DATE-NORMALIZED TO TUI-DATE-NUMBER
        MOVE "Y" TO TUI-DATE-VALID
      END-IF
    END-IF.

FORMAT-SCREEN-DATE.
    INITIALIZE TUI-DATE-TEXT
    STRING TUI-DATE-NUMBER(7:2) "." TUI-DATE-NUMBER(5:2) "."
      TUI-DATE-NUMBER(1:4) INTO TUI-DATE-TEXT
    END-STRING.

SHOW-INPUT-ERROR.
    MOVE "INPUT ERROR" TO TUI-RESULT-TITLE
    MOVE TUI-SCREEN-ERROR(1:72) TO TUI-RESULT-LINE-1
    MOVE 4 TO TUI-RESULT-COLOR
    PERFORM DISPLAY-RESULT-SCREEN.

PREPARE-SERVICE-RESULT.
    INITIALIZE TUI-RESULT-DATA
    IF ASO-STATUS-CODE = APPT-OK
      MOVE "OPERATION COMPLETED" TO TUI-RESULT-TITLE
      MOVE 2 TO TUI-RESULT-COLOR
    ELSE
      MOVE "OPERATION FAILED" TO TUI-RESULT-TITLE
      MOVE 4 TO TUI-RESULT-COLOR
    END-IF
    MOVE ASO-MESSAGE(1:72) TO TUI-RESULT-LINE-1
    STRING "Status code: " ASO-STATUS-CODE
      INTO TUI-RESULT-LINE-2
    END-STRING
    IF ASO-ID NOT = SPACES
      STRING "Appointment ID: " ASO-ID
        INTO TUI-RESULT-LINE-3
      END-STRING
    END-IF
    IF ASO-COUNT > ZERO
      STRING "Affected records: " ASO-COUNT
        INTO TUI-RESULT-LINE-4
      END-STRING
    END-IF
    IF ASO-OUTPUT-PATH NOT = SPACES
      MOVE ASO-OUTPUT-PATH(1:72) TO TUI-RESULT-LINE-5
    END-IF.

DISPLAY-RESULT-SCREEN.
    MOVE SPACE TO TUI-PAUSE
    ACCEPT RESULT-SCREEN.

CALL-SERVICE.
    CALL "APPOINTMENT-SERVICE" USING APPOINTMENT-SERVICE-REQUEST
      APPOINTMENT-SERVICE-RESULT APPOINTMENT-CONFIG.

END PROGRAM CALMGR.
