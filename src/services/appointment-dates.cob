>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. APPOINTMENT-DATES.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "appointment-status.cpy".
LOCAL-STORAGE SECTION.
01 LS-DAY                 PIC S9(9) COMP-5.
01 LS-THURSDAY            PIC S9(9) COMP-5.
01 LS-JAN4                PIC S9(9) COMP-5.
01 LS-DOW                 PIC 9.
01 LS-JAN4-DOW            PIC 9.
01 LS-THURSDAY-DATE       PIC 9(8).
01 LS-JAN4-DATE           PIC 9(8).
LINKAGE SECTION.
01 LK-OPERATION           PIC X(12).
COPY "appointment-date-params.cpy".
01 LK-STATUS              PIC 9(3).
PROCEDURE DIVISION USING LK-OPERATION APPOINTMENT-DATE-PARAMS LK-STATUS.
    MOVE APPT-OK TO LK-STATUS
    EVALUATE FUNCTION TRIM(LK-OPERATION)
      WHEN "VALIDATE"
        IF FUNCTION TEST-DATE-YYYYMMDD(ADP-INPUT-DATE) = 0
          MOVE "Y" TO ADP-VALID
        ELSE
          MOVE "N" TO ADP-VALID
          MOVE APPT-INVALID-DATE TO LK-STATUS
        END-IF
      WHEN "ISO"
        IF FUNCTION TEST-DATE-YYYYMMDD(ADP-INPUT-DATE) NOT = 0
          MOVE APPT-INVALID-DATE TO LK-STATUS
        ELSE
          COMPUTE LS-DAY = FUNCTION INTEGER-OF-DATE(ADP-INPUT-DATE)
          COMPUTE LS-DOW = FUNCTION MOD(LS-DAY - 1, 7) + 1
          COMPUTE LS-THURSDAY = LS-DAY + 4 - LS-DOW
          MOVE FUNCTION DATE-OF-INTEGER(LS-THURSDAY) TO LS-THURSDAY-DATE
          MOVE LS-THURSDAY-DATE(1:4) TO ADP-ISO-YEAR
          MOVE ADP-ISO-YEAR TO LS-JAN4-DATE(1:4)
          MOVE "0104" TO LS-JAN4-DATE(5:4)
          COMPUTE LS-JAN4 = FUNCTION INTEGER-OF-DATE(LS-JAN4-DATE)
          COMPUTE LS-JAN4-DOW = FUNCTION MOD(LS-JAN4 - 1, 7) + 1
          COMPUTE ADP-ISO-WEEK = 1 +
            (LS-THURSDAY - (LS-JAN4 - LS-JAN4-DOW + 1)) / 7
        END-IF
      WHEN "ADD-DAYS"
        IF FUNCTION TEST-DATE-YYYYMMDD(ADP-INPUT-DATE) NOT = 0
          MOVE APPT-INVALID-DATE TO LK-STATUS
        ELSE
          COMPUTE LS-DAY = FUNCTION INTEGER-OF-DATE(ADP-INPUT-DATE)
            + ADP-DAY-NUMBER
          MOVE FUNCTION DATE-OF-INTEGER(LS-DAY) TO ADP-OUTPUT-DATE
        END-IF
      WHEN OTHER
        MOVE APPT-INVALID-REQUEST TO LK-STATUS
    END-EVALUATE
    GOBACK.
END PROGRAM APPOINTMENT-DATES.
