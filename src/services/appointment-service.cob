>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. APPOINTMENT-SERVICE.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "appointment-status.cpy".
01 WS-FILTER-DATA.
   05 WF-OPERATION        PIC X(24).
   05 WF-ID               PIC X(9).
   05 WF-SERIES-ID        PIC X(9).
   05 WF-SCOPE            PIC X(12).
   05 WF-MODE             PIC X(12).
   05 WF-START-DATE       PIC 9(8).
   05 WF-END-DATE         PIC 9(8).
   05 WF-CLIENT           PIC X(60).
   05 WF-SUBJECT          PIC X(100).
   05 WF-STATUS           PIC X.
   05 WF-RECURRENCE       PIC X.
   05 WF-SERIES-UNTIL     PIC 9(8).
   05 WF-CANCEL-NOTE      PIC X(120).
   05 WF-QUERY            PIC X(100).
   05 WF-SORT             PIC X(12).
   05 WF-FROM-DATE        PIC 9(8).
   05 WF-TO-DATE          PIC 9(8).
   05 WF-EXPECTED-REVISION PIC 9(9).
   05 WF-CONFIRM          PIC X(16).
   05 WF-PATH             PIC X(256).
   05 WF-SOURCE           PIC X(8).
   05 WF-USERNAME         PIC X(64).
   05 WF-PASSWORD         PIC X(256).
   05 WF-ACTOR-USERNAME   PIC X(64).
   05 WF-ACTOR-PASSWORD   PIC X(256).
   05 WF-ROLE             PIC X(8).
   05 WF-NEW-PASSWORD     PIC X(256).
   05 WF-USER-ID          PIC X(12).
01 WS-LIST-ACTIVE         PIC X VALUE "N".
01 WS-LIST-COUNT          PIC 9(4) COMP-5 VALUE 0.
01 WS-LIST-INDEX          PIC 9(4) COMP-5 VALUE 0.
01 WS-LIST-TABLE.
   05 WS-LIST-ENTRY       PIC X(389) OCCURS 1000 TIMES.
LOCAL-STORAGE SECTION.
COPY "appointment-repository-request.cpy".
COPY "appointment-record.cpy".
COPY "appointment-date-params.cpy".
01 LS-DATE-OP             PIC X(12).
01 LS-BACKUP-OP           PIC X(12).
01 LS-STATUS              PIC 9(3).
01 LS-MESSAGE             PIC X(160).
01 LS-NEXT-NUMBER         PIC 9(9).
01 LS-NEXT-ID             PIC 9(9).
01 LS-FIRST-ID            PIC X(9).
01 LS-CURRENT-START       PIC 9(8).
01 LS-CURRENT-END         PIC 9(8).
01 LS-DURATION            PIC S9(9) COMP-5.
01 LS-CREATED             PIC 9(5).
01 LS-MATCH               PIC X.
01 LS-NOW                 PIC X(21).
01 LS-TIMESTAMP           PIC X(20).
01 LS-TODAY               PIC 9(8).
01 LS-ACTION              PIC X(24).
01 LS-DETAIL              PIC X(160).
01 LS-ORIGINAL            PIC X(389).
01 LS-SWAP                PIC X(389).
01 LS-SORT-A              PIC X(160).
01 LS-SORT-B              PIC X(160).
01 LS-I                   PIC 9(4) COMP-5.
01 LS-J                   PIC 9(4) COMP-5.
01 LS-TALLY               PIC 9(4) COMP-5.
01 LS-UPPER-CLIENT        PIC X(100).
01 LS-UPPER-SUBJECT       PIC X(100).
01 LS-UPPER-QUERY         PIC X(100).
01 LS-QUERY-LENGTH        PIC 9(3) COMP-5.
01 LS-CSV-OP              PIC X(12).
01 LS-CSV-PATH            PIC X(256).
01 LS-CSV-COUNT           PIC 9(5).
01 LS-AUDIT-ID            PIC X(9).
01 LS-AUDIT-SOURCE        PIC X(8).
01 LS-TX-ACTIVE           PIC X VALUE "N".
01 LS-SAVED-OPERATION     PIC X(24).
LINKAGE SECTION.
COPY "appointment-service-request.cpy".
COPY "appointment-service-result.cpy".
COPY "appointment-config.cpy".
PROCEDURE DIVISION USING APPOINTMENT-SERVICE-REQUEST
    APPOINTMENT-SERVICE-RESULT APPOINTMENT-CONFIG.
    INITIALIZE APPOINTMENT-SERVICE-RESULT
    MOVE APPT-OK TO ASO-STATUS-CODE
    MOVE ASR-OPERATION TO LS-SAVED-OPERATION
    IF ASR-OPERATION = "ADD" OR ASR-OPERATION = "EDIT"
      OR ASR-OPERATION = "CANCEL" OR ASR-OPERATION = "REACTIVATE"
      OR ASR-OPERATION = "DELETE" OR ASR-OPERATION = "CSV-IMPORT"
      MOVE "BEGIN" TO ARR-OPERATION
      PERFORM CALL-REPOSITORY
      IF ASO-STATUS-CODE = APPT-OK MOVE "Y" TO LS-TX-ACTIVE END-IF
    END-IF
    IF ASO-STATUS-CODE NOT = APPT-OK GOBACK END-IF
    MOVE LS-SAVED-OPERATION TO ASR-OPERATION
    EVALUATE FUNCTION TRIM(ASR-OPERATION)
      WHEN "INIT" PERFORM SERVICE-INIT
      WHEN "RESET-DATABASE" PERFORM SERVICE-RESET-DATABASE
      WHEN "ADD" PERFORM SERVICE-ADD
      WHEN "SHOW" PERFORM SERVICE-SHOW
      WHEN "LIST-OPEN" PERFORM SERVICE-LIST-OPEN
      WHEN "LIST-NEXT" PERFORM SERVICE-LIST-NEXT
      WHEN "LIST-CLOSE" PERFORM SERVICE-LIST-CLOSE
      WHEN "EDIT" PERFORM SERVICE-EDIT
      WHEN "CANCEL" PERFORM SERVICE-CANCEL
      WHEN "REACTIVATE" PERFORM SERVICE-REACTIVATE
      WHEN "DELETE" PERFORM SERVICE-DELETE
      WHEN "BACKUP" PERFORM SERVICE-BACKUP
      WHEN "RESTORE" PERFORM SERVICE-RESTORE
      WHEN "PRINT-EXPORT" PERFORM SERVICE-PRINT-EXPORT
      WHEN "PRINT-LIST-EXPORT" PERFORM SERVICE-PRINT-LIST-EXPORT
      WHEN "CSV-EXPORT" PERFORM SERVICE-CSV-EXPORT
      WHEN "ICAL-EXPORT" PERFORM SERVICE-ICAL-EXPORT
      WHEN "CSV-IMPORT" PERFORM SERVICE-CSV-IMPORT
      WHEN OTHER
        MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
        MOVE "Unknown service operation" TO ASO-MESSAGE
    END-EVALUATE
    IF LS-TX-ACTIVE = "Y"
      IF ASO-STATUS-CODE = APPT-OK
        MOVE "COMMIT" TO ARR-OPERATION
      ELSE
        MOVE "ROLLBACK" TO ARR-OPERATION
      END-IF
      PERFORM CALL-REPOSITORY-RAW
      IF ARR-STATUS-CODE NOT = APPT-OK AND ASO-STATUS-CODE = APPT-OK
        MOVE ARR-STATUS-CODE TO ASO-STATUS-CODE
        MOVE ARR-MESSAGE TO ASO-MESSAGE
      END-IF
    END-IF
    GOBACK.

SERVICE-INIT.
    MOVE "ENSURE" TO ARR-OPERATION
    PERFORM CALL-REPOSITORY
    IF ASO-STATUS-CODE = APPT-OK
      MOVE "Repository is ready" TO ASO-MESSAGE
    END-IF.

SERVICE-RESET-DATABASE.
    IF ASR-CONFIRM NOT = "ERASE"
      MOVE APPT-FORBIDDEN TO ASO-STATUS-CODE
      MOVE "Database reset requires confirm=ERASE" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    MOVE "FORCE-INIT" TO ARR-OPERATION
    PERFORM CALL-REPOSITORY
    IF ASO-STATUS-CODE = APPT-OK
      MOVE "Database reset completed" TO ASO-MESSAGE
    END-IF.

SERVICE-SHOW.
    IF ASR-ID NOT NUMERIC
      PERFORM INVALID-ID
      EXIT PARAGRAPH
    END-IF
    MOVE "GET" TO ARR-OPERATION
    MOVE ASR-ID TO ARR-ID
    PERFORM CALL-REPOSITORY
    IF ASO-STATUS-CODE = APPT-OK
      MOVE APPOINTMENT-RECORD TO ASO-APPOINTMENT
      MOVE 1 TO ASO-COUNT
      MOVE "Appointment found" TO ASO-MESSAGE
    ELSE IF ASO-STATUS-CODE = APPT-NOT-FOUND
      MOVE "Appointment not found" TO ASO-MESSAGE
    END-IF.

SERVICE-ADD.
    PERFORM VALIDATE-INPUT
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    PERFORM FIND-DUPLICATE
    IF LS-MATCH = "Y"
      MOVE APPT-DUPLICATE TO ASO-STATUS-CODE
      MOVE "An active appointment with the same dates, client and subject exists"
        TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    PERFORM FIND-NEXT-ID
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    MOVE ASR-START-DATE TO LS-CURRENT-START
    MOVE ASR-END-DATE TO LS-CURRENT-END
    COMPUTE LS-DURATION = FUNCTION INTEGER-OF-DATE(ASR-END-DATE)
      - FUNCTION INTEGER-OF-DATE(ASR-START-DATE)
    MOVE LS-NEXT-ID TO LS-FIRST-ID
    IF ASR-RECURRENCE NOT = "N"
      MOVE "BACKUP" TO LS-BACKUP-OP
      PERFORM CALL-BACKUP
      IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    END-IF
    PERFORM UNTIL LS-CURRENT-START = 0
      PERFORM BUILD-NEW-RECORD
      MOVE "PUT" TO ARR-OPERATION
      PERFORM CALL-REPOSITORY
      IF ASO-STATUS-CODE NOT = APPT-OK
        IF ASR-RECURRENCE NOT = "N"
          MOVE "RESTORE" TO LS-BACKUP-OP
          PERFORM CALL-BACKUP
        END-IF
        EXIT PERFORM
      END-IF
      ADD 1 TO LS-CREATED LS-NEXT-ID
      IF ASR-RECURRENCE = "N" OR ASR-SERIES-UNTIL = 0
        MOVE 0 TO LS-CURRENT-START
      ELSE
        INITIALIZE APPOINTMENT-DATE-PARAMS
        MOVE LS-CURRENT-START TO ADP-INPUT-DATE
        MOVE ASR-RECURRENCE TO ADP-RECURRENCE
        MOVE ASR-START-DATE(7:2) TO ADP-ANCHOR-DAY
        CALL "APPOINTMENT-RECURRENCE" USING APPOINTMENT-DATE-PARAMS LS-STATUS
        IF LS-STATUS NOT = APPT-OK OR ADP-OUTPUT-DATE > ASR-SERIES-UNTIL
          MOVE 0 TO LS-CURRENT-START
        ELSE
          MOVE ADP-OUTPUT-DATE TO LS-CURRENT-START
          MOVE "ADD-DAYS" TO LS-DATE-OP
          MOVE LS-CURRENT-START TO ADP-INPUT-DATE
          MOVE LS-DURATION TO ADP-DAY-NUMBER
          CALL "APPOINTMENT-DATES" USING LS-DATE-OP
            APPOINTMENT-DATE-PARAMS LS-STATUS
          MOVE ADP-OUTPUT-DATE TO LS-CURRENT-END
        END-IF
      END-IF
      IF LS-CREATED >= 1000
        MOVE APPT-FORBIDDEN TO ASO-STATUS-CODE
        MOVE "A series is limited to 1000 occurrences" TO ASO-MESSAGE
        MOVE 0 TO LS-CURRENT-START
      END-IF
    END-PERFORM
    IF ASO-STATUS-CODE = APPT-OK
      MOVE LS-CREATED TO ASO-COUNT
      MOVE LS-FIRST-ID TO ASO-ID
      MOVE LS-FIRST-ID TO ASR-ID
      MOVE "Appointment(s) created" TO ASO-MESSAGE
      MOVE "ADD" TO LS-ACTION
      MOVE "Created appointment or series" TO LS-DETAIL
      PERFORM WRITE-AUDIT
    END-IF.

BUILD-NEW-RECORD.
    INITIALIZE APPOINTMENT-RECORD
    MOVE 3 TO AR-SCHEMA-VERSION
    MOVE LS-NEXT-ID TO AR-ID
    IF ASR-RECURRENCE = "N" MOVE ZEROES TO AR-SERIES-ID
    ELSE MOVE LS-FIRST-ID TO AR-SERIES-ID END-IF
    MOVE LS-CURRENT-START TO AR-START-DATE
    MOVE LS-CURRENT-END TO AR-END-DATE
    MOVE ASR-CLIENT TO AR-CLIENT
    MOVE ASR-SUBJECT TO AR-SUBJECT
    MOVE "A" TO AR-STATUS
    MOVE ASR-RECURRENCE TO AR-RECURRENCE
    MOVE ASR-SERIES-UNTIL TO AR-SERIES-UNTIL
    MOVE 1 TO AR-REVISION
    PERFORM MAKE-TIMESTAMP
    MOVE LS-TIMESTAMP TO AR-CREATED-AT AR-UPDATED-AT
    MOVE "ISO" TO LS-DATE-OP
    INITIALIZE APPOINTMENT-DATE-PARAMS
    MOVE AR-START-DATE TO ADP-INPUT-DATE
    CALL "APPOINTMENT-DATES" USING LS-DATE-OP APPOINTMENT-DATE-PARAMS LS-STATUS
    MOVE ADP-ISO-YEAR TO AR-ISO-YEAR
    MOVE ADP-ISO-WEEK TO AR-ISO-WEEK.

VALIDATE-INPUT.
    IF ASR-START-DATE = 0 OR ASR-END-DATE = 0
      MOVE APPT-INVALID-DATE TO ASO-STATUS-CODE
      MOVE "Start and end dates are required" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    MOVE "VALIDATE" TO LS-DATE-OP
    INITIALIZE APPOINTMENT-DATE-PARAMS
    MOVE ASR-START-DATE TO ADP-INPUT-DATE
    CALL "APPOINTMENT-DATES" USING LS-DATE-OP APPOINTMENT-DATE-PARAMS LS-STATUS
    IF LS-STATUS NOT = APPT-OK
      MOVE LS-STATUS TO ASO-STATUS-CODE
      MOVE "Invalid start date" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    MOVE ASR-END-DATE TO ADP-INPUT-DATE
    CALL "APPOINTMENT-DATES" USING LS-DATE-OP APPOINTMENT-DATE-PARAMS LS-STATUS
    IF LS-STATUS NOT = APPT-OK OR ASR-END-DATE < ASR-START-DATE
      MOVE APPT-INVALID-DATE TO ASO-STATUS-CODE
      MOVE "Invalid date range" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    IF ASR-CLIENT = SPACES OR ASR-SUBJECT = SPACES
      MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
      MOVE "Client and subject are required" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    MOVE 0 TO LS-TALLY
    INSPECT ASR-CLIENT TALLYING LS-TALLY FOR ALL "|"
    INSPECT ASR-SUBJECT TALLYING LS-TALLY FOR ALL "|"
    IF LS-TALLY > 0
      MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
      MOVE "The pipe character is not allowed" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    IF ASR-RECURRENCE NOT = "N" AND ASR-RECURRENCE NOT = "W"
      AND ASR-RECURRENCE NOT = "B" AND ASR-RECURRENCE NOT = "M"
      AND ASR-RECURRENCE NOT = "Y"
      MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
      MOVE "Recurrence must be N, W, B, M or Y" TO ASO-MESSAGE
    END-IF.

FIND-DUPLICATE.
    MOVE "N" TO LS-MATCH
    MOVE "OPEN-SCAN" TO ARR-OPERATION
    PERFORM CALL-REPOSITORY
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    PERFORM UNTIL LS-MATCH = "Y" OR ARR-STATUS-CODE NOT = APPT-OK
      MOVE "NEXT-SCAN" TO ARR-OPERATION
      PERFORM CALL-REPOSITORY-RAW
      IF ARR-STATUS-CODE = APPT-OK
        IF AR-STATUS = "A" AND AR-ID NOT = ASR-ID
          AND AR-START-DATE = ASR-START-DATE
          AND AR-END-DATE = ASR-END-DATE
          AND FUNCTION TRIM(AR-CLIENT) = FUNCTION TRIM(ASR-CLIENT)
          AND FUNCTION TRIM(AR-SUBJECT) = FUNCTION TRIM(ASR-SUBJECT)
          MOVE "Y" TO LS-MATCH
        END-IF
      END-IF
    END-PERFORM
    MOVE ARR-STATUS-CODE TO LS-STATUS
    MOVE ARR-MESSAGE TO LS-MESSAGE
    MOVE "CLOSE-SCAN" TO ARR-OPERATION
    PERFORM CALL-REPOSITORY-RAW
    IF LS-STATUS = APPT-NOT-FOUND OR LS-MATCH = "Y"
      MOVE APPT-OK TO ASO-STATUS-CODE
    ELSE
      MOVE LS-STATUS TO ASO-STATUS-CODE MOVE LS-MESSAGE TO ASO-MESSAGE
    END-IF.

FIND-NEXT-ID.
    MOVE 1 TO LS-NEXT-ID
    MOVE "OPEN-SCAN" TO ARR-OPERATION
    PERFORM CALL-REPOSITORY
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    PERFORM UNTIL ARR-STATUS-CODE NOT = APPT-OK
      MOVE "NEXT-SCAN" TO ARR-OPERATION
      PERFORM CALL-REPOSITORY-RAW
      IF ARR-STATUS-CODE = APPT-OK AND AR-ID NUMERIC
        MOVE AR-ID TO LS-NEXT-NUMBER
        IF LS-NEXT-NUMBER >= LS-NEXT-ID COMPUTE LS-NEXT-ID = LS-NEXT-NUMBER + 1 END-IF
      END-IF
    END-PERFORM
    MOVE ARR-STATUS-CODE TO LS-STATUS
    MOVE ARR-MESSAGE TO LS-MESSAGE
    MOVE "CLOSE-SCAN" TO ARR-OPERATION
    PERFORM CALL-REPOSITORY-RAW
    IF LS-STATUS = APPT-NOT-FOUND
      MOVE APPT-OK TO ASO-STATUS-CODE
    ELSE
      MOVE LS-STATUS TO ASO-STATUS-CODE MOVE LS-MESSAGE TO ASO-MESSAGE
    END-IF.

SERVICE-LIST-OPEN.
    MOVE APPOINTMENT-SERVICE-REQUEST TO WS-FILTER-DATA
    MOVE 0 TO WS-LIST-COUNT WS-LIST-INDEX
    MOVE "OPEN-SCAN" TO ARR-OPERATION
    PERFORM CALL-REPOSITORY
    IF ASO-STATUS-CODE = APPT-OK
      PERFORM UNTIL ARR-STATUS-CODE NOT = APPT-OK
        MOVE "NEXT-SCAN" TO ARR-OPERATION
        PERFORM CALL-REPOSITORY-RAW
        IF ARR-STATUS-CODE = APPT-OK
          PERFORM MATCH-FILTER
          IF LS-MATCH = "Y" AND WS-LIST-COUNT < 1000
            ADD 1 TO WS-LIST-COUNT
            MOVE APPOINTMENT-RECORD TO WS-LIST-ENTRY(WS-LIST-COUNT)
          END-IF
        END-IF
      END-PERFORM
      MOVE ARR-STATUS-CODE TO LS-STATUS
      MOVE ARR-MESSAGE TO LS-MESSAGE
      MOVE "CLOSE-SCAN" TO ARR-OPERATION PERFORM CALL-REPOSITORY-RAW
      IF LS-STATUS = APPT-NOT-FOUND
        PERFORM SORT-LIST
        MOVE "Y" TO WS-LIST-ACTIVE
        MOVE APPT-OK TO ASO-STATUS-CODE
        MOVE WS-LIST-COUNT TO ASO-COUNT
      ELSE
        MOVE LS-STATUS TO ASO-STATUS-CODE MOVE LS-MESSAGE TO ASO-MESSAGE
      END-IF
    END-IF.

SERVICE-LIST-NEXT.
    IF WS-LIST-ACTIVE NOT = "Y"
      MOVE APPT-INTERNAL-ERROR TO ASO-STATUS-CODE
      MOVE "List cursor is not open" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    IF WS-LIST-INDEX < WS-LIST-COUNT
      ADD 1 TO WS-LIST-INDEX
      MOVE WS-LIST-ENTRY(WS-LIST-INDEX) TO APPOINTMENT-RECORD
      MOVE APPOINTMENT-RECORD TO ASO-APPOINTMENT
      MOVE 1 TO ASO-COUNT
    ELSE
      MOVE APPT-NOT-FOUND TO ASO-STATUS-CODE
      MOVE "End of list" TO ASO-MESSAGE
    END-IF.

MATCH-FILTER.
    MOVE "Y" TO LS-MATCH
    IF WF-MODE = "current" AND AR-STATUS NOT = "A"
      MOVE "N" TO LS-MATCH
    END-IF
    IF WF-STATUS NOT = SPACE
      AND AR-STATUS NOT = WF-STATUS MOVE "N" TO LS-MATCH END-IF
    IF WF-SERIES-ID NOT = SPACES AND WF-SERIES-ID NOT = ZEROES
      AND AR-SERIES-ID NOT = WF-SERIES-ID MOVE "N" TO LS-MATCH END-IF
    IF WF-FROM-DATE > 0 AND AR-END-DATE < WF-FROM-DATE MOVE "N" TO LS-MATCH END-IF
    IF WF-TO-DATE > 0 AND AR-START-DATE > WF-TO-DATE MOVE "N" TO LS-MATCH END-IF
    IF WF-QUERY NOT = SPACES
      MOVE FUNCTION UPPER-CASE(AR-CLIENT) TO LS-UPPER-CLIENT
      MOVE FUNCTION UPPER-CASE(AR-SUBJECT) TO LS-UPPER-SUBJECT
      MOVE FUNCTION UPPER-CASE(WF-QUERY) TO LS-UPPER-QUERY
      COMPUTE LS-QUERY-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(LS-UPPER-QUERY))
      MOVE 0 TO LS-TALLY
      INSPECT LS-UPPER-CLIENT TALLYING LS-TALLY
        FOR ALL LS-UPPER-QUERY(1:LS-QUERY-LENGTH)
      INSPECT LS-UPPER-SUBJECT TALLYING LS-TALLY
        FOR ALL LS-UPPER-QUERY(1:LS-QUERY-LENGTH)
      IF LS-TALLY = 0 MOVE "N" TO LS-MATCH END-IF
    END-IF.

SERVICE-LIST-CLOSE.
    MOVE "N" TO WS-LIST-ACTIVE
    MOVE 0 TO WS-LIST-COUNT WS-LIST-INDEX.

SORT-LIST.
    IF WF-SORT = SPACES MOVE "start" TO WF-SORT END-IF
    PERFORM VARYING LS-I FROM 1 BY 1 UNTIL LS-I >= WS-LIST-COUNT
      PERFORM VARYING LS-J FROM LS-I BY 1 UNTIL LS-J >= WS-LIST-COUNT
        PERFORM BUILD-SORT-KEYS
        IF LS-SORT-A > LS-SORT-B
          MOVE WS-LIST-ENTRY(LS-I) TO LS-SWAP
          MOVE WS-LIST-ENTRY(LS-J + 1) TO WS-LIST-ENTRY(LS-I)
          MOVE LS-SWAP TO WS-LIST-ENTRY(LS-J + 1)
        END-IF
      END-PERFORM
    END-PERFORM.

BUILD-SORT-KEYS.
    INITIALIZE LS-SORT-A LS-SORT-B
    EVALUATE FUNCTION TRIM(WF-SORT)
      WHEN "client"
        STRING FUNCTION UPPER-CASE(WS-LIST-ENTRY(LS-I)(43:60))
          WS-LIST-ENTRY(LS-I)(21:8) WS-LIST-ENTRY(LS-I)(3:9)
          INTO LS-SORT-A END-STRING
        STRING FUNCTION UPPER-CASE(WS-LIST-ENTRY(LS-J + 1)(43:60))
          WS-LIST-ENTRY(LS-J + 1)(21:8) WS-LIST-ENTRY(LS-J + 1)(3:9)
          INTO LS-SORT-B END-STRING
      WHEN "subject"
        STRING FUNCTION UPPER-CASE(WS-LIST-ENTRY(LS-I)(103:100))
          WS-LIST-ENTRY(LS-I)(21:8) INTO LS-SORT-A END-STRING
        STRING FUNCTION UPPER-CASE(WS-LIST-ENTRY(LS-J + 1)(103:100))
          WS-LIST-ENTRY(LS-J + 1)(21:8) INTO LS-SORT-B END-STRING
      WHEN "id"
        MOVE WS-LIST-ENTRY(LS-I)(3:9) TO LS-SORT-A
        MOVE WS-LIST-ENTRY(LS-J + 1)(3:9) TO LS-SORT-B
      WHEN OTHER
        STRING WS-LIST-ENTRY(LS-I)(21:8) WS-LIST-ENTRY(LS-I)(3:9)
          INTO LS-SORT-A END-STRING
        STRING WS-LIST-ENTRY(LS-J + 1)(21:8) WS-LIST-ENTRY(LS-J + 1)(3:9)
          INTO LS-SORT-B END-STRING
    END-EVALUATE.

SERVICE-EDIT.
    PERFORM LOAD-TARGET
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    IF ASR-EXPECTED-REVISION > 0 AND ASR-EXPECTED-REVISION NOT = AR-REVISION
      MOVE APPT-CONFLICT TO ASO-STATUS-CODE
      MOVE "Appointment was changed by another client" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    MOVE "BACKUP" TO LS-BACKUP-OP
    PERFORM CALL-BACKUP
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    MOVE APPOINTMENT-RECORD TO LS-ORIGINAL
    PERFORM APPLY-EDIT-FIELDS
    PERFORM VALIDATE-EDITED-RECORD
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    PERFORM UPDATE-ONE
    IF ASO-STATUS-CODE = APPT-OK AND ASR-SCOPE NOT = "single"
      PERFORM APPLY-EDIT-TO-SERIES
    END-IF
    IF ASO-STATUS-CODE NOT = APPT-OK
      MOVE "RESTORE" TO LS-BACKUP-OP
      PERFORM CALL-BACKUP
    ELSE
      MOVE "EDIT" TO LS-ACTION
      MOVE "Edited appointment or series" TO LS-DETAIL
      PERFORM WRITE-AUDIT
      MOVE "Appointment(s) updated" TO ASO-MESSAGE
    END-IF.

APPLY-EDIT-FIELDS.
    IF ASR-START-DATE > 0 MOVE ASR-START-DATE TO AR-START-DATE END-IF
    IF ASR-END-DATE > 0 MOVE ASR-END-DATE TO AR-END-DATE END-IF
    IF ASR-CLIENT NOT = SPACES MOVE ASR-CLIENT TO AR-CLIENT END-IF
    IF ASR-SUBJECT NOT = SPACES MOVE ASR-SUBJECT TO AR-SUBJECT END-IF
    IF ASR-SERIES-UNTIL > 0 MOVE ASR-SERIES-UNTIL TO AR-SERIES-UNTIL END-IF
    PERFORM REFRESH-RECORD-METADATA.

VALIDATE-EDITED-RECORD.
    IF FUNCTION TEST-DATE-YYYYMMDD(AR-START-DATE) NOT = 0
      OR FUNCTION TEST-DATE-YYYYMMDD(AR-END-DATE) NOT = 0
      OR AR-END-DATE < AR-START-DATE
      MOVE APPT-INVALID-DATE TO ASO-STATUS-CODE
      MOVE "Invalid edited date range" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    IF AR-CLIENT = SPACES OR AR-SUBJECT = SPACES
      MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
      MOVE "Client and subject are required" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    MOVE AR-START-DATE TO ASR-START-DATE
    MOVE AR-END-DATE TO ASR-END-DATE
    MOVE AR-CLIENT TO ASR-CLIENT
    MOVE AR-SUBJECT TO ASR-SUBJECT
    MOVE APPOINTMENT-RECORD TO LS-ORIGINAL
    PERFORM FIND-DUPLICATE
    MOVE LS-ORIGINAL TO APPOINTMENT-RECORD
    IF LS-MATCH = "Y"
      MOVE APPT-DUPLICATE TO ASO-STATUS-CODE
      MOVE "The edit would create a duplicate appointment" TO ASO-MESSAGE
    END-IF.

APPLY-EDIT-TO-SERIES.
    IF AR-SERIES-ID = ZEROES EXIT PARAGRAPH END-IF
    MOVE "OPEN-SCAN" TO ARR-OPERATION
    PERFORM CALL-REPOSITORY
    PERFORM UNTIL ARR-STATUS-CODE NOT = APPT-OK OR ASO-STATUS-CODE NOT = APPT-OK
      MOVE "NEXT-SCAN" TO ARR-OPERATION
      PERFORM CALL-REPOSITORY-RAW
      IF ARR-STATUS-CODE = APPT-OK AND AR-SERIES-ID = ASO-SERIES-ID
        AND AR-ID NOT = ASR-ID
        IF ASR-SCOPE = "series" OR AR-START-DATE >= ASO-START-DATE
          IF ASR-CLIENT NOT = SPACES MOVE ASR-CLIENT TO AR-CLIENT END-IF
          IF ASR-SUBJECT NOT = SPACES MOVE ASR-SUBJECT TO AR-SUBJECT END-IF
          IF ASR-SERIES-UNTIL > 0 MOVE ASR-SERIES-UNTIL TO AR-SERIES-UNTIL END-IF
          PERFORM REFRESH-RECORD-METADATA
          MOVE "UPDATE" TO ARR-OPERATION
          PERFORM CALL-REPOSITORY
          IF ASO-STATUS-CODE = APPT-OK ADD 1 TO ASO-COUNT END-IF
        END-IF
      END-IF
    END-PERFORM
    MOVE "CLOSE-SCAN" TO ARR-OPERATION
    PERFORM CALL-REPOSITORY-RAW.

UPDATE-ONE.
    MOVE "UPDATE" TO ARR-OPERATION
    PERFORM CALL-REPOSITORY
    IF ASO-STATUS-CODE = APPT-OK
      ADD 1 TO ASO-COUNT
      MOVE APPOINTMENT-RECORD TO ASO-APPOINTMENT
    END-IF.

SERVICE-CANCEL.
    PERFORM LOAD-TARGET
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    IF AR-STATUS = "C"
      MOVE APPT-FORBIDDEN TO ASO-STATUS-CODE
      MOVE "Appointment is already cancelled" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    MOVE "BACKUP" TO LS-BACKUP-OP
    PERFORM CALL-BACKUP
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    PERFORM MARK-CANCELLED
    PERFORM UPDATE-ONE
    IF ASO-STATUS-CODE = APPT-OK AND ASR-SCOPE NOT = "single"
      PERFORM CANCEL-SERIES
    END-IF
    IF ASO-STATUS-CODE NOT = APPT-OK
      MOVE "RESTORE" TO LS-BACKUP-OP PERFORM CALL-BACKUP
    ELSE
      MOVE "CANCEL" TO LS-ACTION
      MOVE "Cancelled appointment or series" TO LS-DETAIL
      PERFORM WRITE-AUDIT
      MOVE "Appointment(s) cancelled" TO ASO-MESSAGE
    END-IF.

MARK-CANCELLED.
    MOVE "C" TO AR-STATUS
    MOVE FUNCTION CURRENT-DATE TO LS-NOW
    MOVE LS-NOW(1:8) TO AR-CANCELLED-ON
    MOVE ASR-CANCEL-NOTE TO AR-CANCEL-NOTE
    PERFORM REFRESH-RECORD-METADATA.

CANCEL-SERIES.
    IF AR-SERIES-ID = ZEROES EXIT PARAGRAPH END-IF
    MOVE ASO-SERIES-ID TO ASR-SERIES-ID
    MOVE "OPEN-SCAN" TO ARR-OPERATION PERFORM CALL-REPOSITORY
    PERFORM UNTIL ARR-STATUS-CODE NOT = APPT-OK OR ASO-STATUS-CODE NOT = APPT-OK
      MOVE "NEXT-SCAN" TO ARR-OPERATION PERFORM CALL-REPOSITORY-RAW
      IF ARR-STATUS-CODE = APPT-OK AND AR-SERIES-ID = ASR-SERIES-ID
        AND AR-ID NOT = ASR-ID AND AR-STATUS = "A"
        IF ASR-SCOPE = "series" OR AR-START-DATE >= ASO-START-DATE
          PERFORM MARK-CANCELLED
          MOVE "UPDATE" TO ARR-OPERATION PERFORM CALL-REPOSITORY
          ADD 1 TO ASO-COUNT
        END-IF
      END-IF
    END-PERFORM
    MOVE "CLOSE-SCAN" TO ARR-OPERATION PERFORM CALL-REPOSITORY-RAW.

SERVICE-REACTIVATE.
    PERFORM LOAD-TARGET
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    IF AR-STATUS NOT = "C"
      MOVE APPT-FORBIDDEN TO ASO-STATUS-CODE
      MOVE "Only cancelled appointments can be reactivated" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    MOVE "BACKUP" TO LS-BACKUP-OP PERFORM CALL-BACKUP
    MOVE "A" TO AR-STATUS
    MOVE ZEROES TO AR-CANCELLED-ON
    MOVE SPACES TO AR-CANCEL-NOTE
    PERFORM REFRESH-RECORD-METADATA
    PERFORM UPDATE-ONE
    IF ASO-STATUS-CODE = APPT-OK
      MOVE "REACTIVATE" TO LS-ACTION
      MOVE "Reactivated appointment" TO LS-DETAIL PERFORM WRITE-AUDIT
      MOVE "Appointment reactivated" TO ASO-MESSAGE
    END-IF.

SERVICE-DELETE.
    PERFORM LOAD-TARGET
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    IF AR-STATUS NOT = "C" OR ASR-CONFIRM NOT = "DELETE"
      MOVE APPT-FORBIDDEN TO ASO-STATUS-CODE
      MOVE "Permanent deletion requires a cancelled record and confirm=DELETE"
        TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    MOVE FUNCTION CURRENT-DATE TO LS-NOW
    MOVE LS-NOW(1:8) TO LS-TODAY
    IF FUNCTION INTEGER-OF-DATE(LS-TODAY)
      - FUNCTION INTEGER-OF-DATE(AR-CANCELLED-ON) < AC-CANCEL-RETENTION
      MOVE APPT-FORBIDDEN TO ASO-STATUS-CODE
      MOVE "Cancelled appointment is still inside the retention period"
        TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    MOVE "BACKUP" TO LS-BACKUP-OP PERFORM CALL-BACKUP
    MOVE "DELETE" TO ARR-OPERATION MOVE ASR-ID TO ARR-ID
    PERFORM CALL-REPOSITORY
    IF ASO-STATUS-CODE = APPT-OK
      MOVE 1 TO ASO-COUNT
      MOVE "DELETE" TO LS-ACTION
      MOVE "Permanently deleted cancelled appointment" TO LS-DETAIL
      PERFORM WRITE-AUDIT
      MOVE "Appointment permanently deleted" TO ASO-MESSAGE
    END-IF.

SERVICE-BACKUP.
    MOVE "BACKUP" TO LS-BACKUP-OP PERFORM CALL-BACKUP
    IF ASO-STATUS-CODE = APPT-OK
      MOVE LS-MESSAGE TO ASO-MESSAGE
      MOVE AC-BACKUP-FILE TO ASO-OUTPUT-PATH
    END-IF.
SERVICE-RESTORE.
    IF ASR-CONFIRM NOT = "RESTORE"
      MOVE APPT-FORBIDDEN TO ASO-STATUS-CODE
      MOVE "Restore requires confirm=RESTORE" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    MOVE "SNAPSHOT" TO LS-BACKUP-OP PERFORM CALL-BACKUP
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    MOVE "RESTORE" TO LS-BACKUP-OP PERFORM CALL-BACKUP
    IF ASO-STATUS-CODE = APPT-OK
      MOVE LS-MESSAGE TO ASO-MESSAGE
      MOVE "RESTORE" TO LS-ACTION MOVE ZEROES TO ASR-ID
      MOVE "Restored latest backup" TO LS-DETAIL PERFORM WRITE-AUDIT
    END-IF.

SERVICE-PRINT-EXPORT.
    MOVE "PRINT" TO LS-BACKUP-OP
    CALL "APPOINTMENT-EXPORT" USING LS-BACKUP-OP APPOINTMENT-SERVICE-REQUEST
      APPOINTMENT-SERVICE-RESULT APPOINTMENT-CONFIG.
SERVICE-PRINT-LIST-EXPORT.
    MOVE "PRINT-LIST" TO LS-BACKUP-OP
    CALL "APPOINTMENT-EXPORT" USING LS-BACKUP-OP APPOINTMENT-SERVICE-REQUEST
      APPOINTMENT-SERVICE-RESULT APPOINTMENT-CONFIG.
SERVICE-CSV-EXPORT.
    MOVE "CSV" TO LS-BACKUP-OP
    CALL "APPOINTMENT-EXPORT" USING LS-BACKUP-OP APPOINTMENT-SERVICE-REQUEST
      APPOINTMENT-SERVICE-RESULT APPOINTMENT-CONFIG.
SERVICE-ICAL-EXPORT.
    MOVE "ICAL" TO LS-BACKUP-OP
    CALL "APPOINTMENT-EXPORT" USING LS-BACKUP-OP APPOINTMENT-SERVICE-REQUEST
      APPOINTMENT-SERVICE-RESULT APPOINTMENT-CONFIG.

SERVICE-CSV-IMPORT.
    IF ASR-PATH = SPACES
      MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
      MOVE "CSV import path is required" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    MOVE ASR-PATH TO LS-CSV-PATH
    MOVE "BACKUP" TO LS-BACKUP-OP PERFORM CALL-BACKUP
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    MOVE "OPEN" TO LS-CSV-OP
    CALL "APPOINTMENT-CSV-READER" USING LS-CSV-OP APPOINTMENT-SERVICE-REQUEST
      LS-STATUS LS-MESSAGE
    IF LS-STATUS NOT = APPT-OK
      MOVE LS-STATUS TO ASO-STATUS-CODE MOVE LS-MESSAGE TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    PERFORM UNTIL LS-STATUS = APPT-NOT-FOUND OR ASO-STATUS-CODE NOT = APPT-OK
      MOVE LS-CSV-PATH TO ASR-PATH
      MOVE "NEXT" TO LS-CSV-OP
      CALL "APPOINTMENT-CSV-READER" USING LS-CSV-OP APPOINTMENT-SERVICE-REQUEST
        LS-STATUS LS-MESSAGE
      IF LS-STATUS = APPT-OK
        PERFORM SERVICE-ADD
        IF ASO-STATUS-CODE = APPT-OK ADD 1 TO LS-CSV-COUNT END-IF
      END-IF
    END-PERFORM
    MOVE "CLOSE" TO LS-CSV-OP
    CALL "APPOINTMENT-CSV-READER" USING LS-CSV-OP APPOINTMENT-SERVICE-REQUEST
      LS-STATUS LS-MESSAGE
    IF ASO-STATUS-CODE NOT = APPT-OK
      MOVE "RESTORE" TO LS-BACKUP-OP PERFORM CALL-BACKUP
    ELSE
      MOVE LS-CSV-COUNT TO ASO-COUNT
      MOVE "CSV import completed" TO ASO-MESSAGE
    END-IF.

LOAD-TARGET.
    IF ASR-ID NOT NUMERIC PERFORM INVALID-ID EXIT PARAGRAPH END-IF
    MOVE "GET" TO ARR-OPERATION MOVE ASR-ID TO ARR-ID
    PERFORM CALL-REPOSITORY
    IF ASO-STATUS-CODE = APPT-OK
      MOVE APPOINTMENT-RECORD TO ASO-APPOINTMENT
    ELSE IF ASO-STATUS-CODE = APPT-NOT-FOUND
      MOVE "Appointment not found" TO ASO-MESSAGE
    END-IF.

REFRESH-RECORD-METADATA.
    ADD 1 TO AR-REVISION
    PERFORM MAKE-TIMESTAMP
    MOVE LS-TIMESTAMP TO AR-UPDATED-AT
    MOVE "ISO" TO LS-DATE-OP
    INITIALIZE APPOINTMENT-DATE-PARAMS
    MOVE AR-START-DATE TO ADP-INPUT-DATE
    CALL "APPOINTMENT-DATES" USING LS-DATE-OP APPOINTMENT-DATE-PARAMS LS-STATUS
    MOVE ADP-ISO-YEAR TO AR-ISO-YEAR MOVE ADP-ISO-WEEK TO AR-ISO-WEEK.

MAKE-TIMESTAMP.
    MOVE FUNCTION CURRENT-DATE TO LS-NOW
    STRING LS-NOW(1:4) "-" LS-NOW(5:2) "-" LS-NOW(7:2) "T"
      LS-NOW(9:2) ":" LS-NOW(11:2) ":" LS-NOW(13:2) "Z"
      INTO LS-TIMESTAMP END-STRING.

WRITE-AUDIT.
    MOVE ASR-ID TO LS-AUDIT-ID
    MOVE ASR-SOURCE TO LS-AUDIT-SOURCE
    CALL "APPOINTMENT-AUDIT" USING LS-ACTION LS-AUDIT-ID LS-AUDIT-SOURCE
      LS-DETAIL APPOINTMENT-CONFIG LS-STATUS
    IF LS-STATUS NOT = APPT-OK
      MOVE "Operation succeeded, but audit logging failed" TO ASO-MESSAGE
    END-IF.

CALL-BACKUP.
    IF LS-BACKUP-OP = "RESTORE" AND LS-TX-ACTIVE = "Y"
      EXIT PARAGRAPH
    END-IF
    CALL "APPOINTMENT-BACKUP" USING LS-BACKUP-OP APPOINTMENT-CONFIG
      LS-STATUS LS-MESSAGE
    IF LS-STATUS NOT = APPT-OK
      MOVE LS-STATUS TO ASO-STATUS-CODE MOVE LS-MESSAGE TO ASO-MESSAGE
    END-IF.

CALL-REPOSITORY.
    PERFORM CALL-REPOSITORY-RAW
    MOVE ARR-STATUS-CODE TO ASO-STATUS-CODE
    IF ARR-MESSAGE NOT = SPACES MOVE ARR-MESSAGE TO ASO-MESSAGE END-IF.
CALL-REPOSITORY-RAW.
    CALL "APPOINTMENT-REPOSITORY" USING APPOINTMENT-REPOSITORY-REQUEST
      APPOINTMENT-RECORD APPOINTMENT-CONFIG.

INVALID-ID.
    MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
    MOVE "Appointment ID must contain nine digits" TO ASO-MESSAGE.
END PROGRAM APPOINTMENT-SERVICE.
