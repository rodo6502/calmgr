>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. APPOINTMENT-EXPORT.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT EXPORT-FILE ASSIGN TO DYNAMIC LS-TEMP-PATH
      ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS LS-FS.
    SELECT PRINT-FILE ASSIGN TO DYNAMIC LS-TEMP-PATH
      ORGANIZATION IS BINARY SEQUENTIAL FILE STATUS IS LS-PRINT-FS.
DATA DIVISION.
FILE SECTION.
FD EXPORT-FILE.
01 EXPORT-LINE            PIC X(1024).
FD PRINT-FILE.
01 PRINT-RECORD.
   05 PRINT-TEXT          PIC X(80).
   05 PRINT-CR            PIC X VALUE X"0D".
   05 PRINT-LF            PIC X VALUE X"0A".
WORKING-STORAGE SECTION.
COPY "appointment-status.cpy".
LOCAL-STORAGE SECTION.
COPY "appointment-repository-request.cpy".
COPY "appointment-record.cpy".
COPY "appointment-date-params.cpy".
01 LS-OUTPUT-PATH         PIC X(256).
01 LS-TEMP-PATH           PIC X(256).
01 LS-FS                  PIC XX.
01 LS-PRINT-FS            PIC XX.
01 LS-STATUS              PIC 9(3).
01 LS-MESSAGE             PIC X(160).
01 LS-COUNT               PIC 9(5).
01 LS-RETURN              PIC S9(9) COMP-5.
01 LS-CALENDAR-DATA.
   05 LS-FIRST-YEAR       PIC 9(4).
   05 LS-LAST-YEAR        PIC 9(4).
   05 LS-RANGE-START      PIC 9(8).
   05 LS-RANGE-END        PIC 9(8).
   05 LS-EXPORT-YEAR      PIC 9(4).
   05 LS-YEAR-DISPLAY     PIC 9(4).
   05 LS-LAST-WEEK        PIC 99.
   05 LS-WEEK             PIC 99.
   05 LS-WEEK-DISPLAY     PIC 99.
   05 LS-PAGE-NUMBER      PIC 999.
   05 LS-PAGE-DISPLAY     PIC ZZ9.
   05 LS-FINAL-PAGE       PIC X VALUE "N".
   05 LS-LINE-NUMBER      PIC 9(3).
   05 LS-LAST-CONTENT     PIC 9(3).
   05 LS-CONTINUATION     PIC X.
   05 LS-WEEK-HAS-APPTS   PIC X.
   05 LS-TOP-MARGIN       PIC 99.
   05 LS-MARGIN-INDEX     PIC 99.
   05 LS-PRINT-COUNT      PIC 9(4) COMP-5.
   05 LS-PRINT-INDEX      PIC 9(4) COMP-5.
   05 LS-SORT-I           PIC 9(4) COMP-5.
   05 LS-SORT-J           PIC 9(4) COMP-5.
   05 LS-TODAY-RAW        PIC X(21).
   05 LS-DATE-LONG        PIC X(10).
   05 LS-DATE-DISPLAY     PIC X(10).
   05 LS-DATE-RANGE       PIC X(13).
   05 LS-PRINT-CLIENT     PIC X(16).
   05 LS-SUBJECT-UPPER    PIC X(100).
   05 LS-REMAINING-TEXT   PIC X(100).
   05 LS-TEXT-LENGTH      PIC 9(3) COMP-5.
   05 LS-CUT-POSITION     PIC 9(3) COMP-5.
   05 LS-SEARCH-POSITION  PIC 9(3) COMP-5.
   05 LS-START-POSITION   PIC 9(3) COMP-5.
   05 LS-REMAINING-LENGTH PIC 9(3) COMP-5.
   05 LS-WRAP-COUNT       PIC 99.
   05 LS-WRAP-INDEX       PIC 99.
   05 LS-BLOCK-START-PAGE PIC 999.
   05 LS-BLOCK-START-LINE PIC 9(3).
   05 LS-BLOCK-ERRORS     PIC 99.
   05 LS-WRITTEN-LINES    PIC 99.
01 LS-WRAP-TABLE.
   05 LS-WRAP-LINE OCCURS 10 TIMES PIC X(43).
01 LS-PRINT-TABLE.
   05 LS-PRINT-ENTRY OCCURS 5000 TIMES PIC X(389).
01 LS-PRINT-SWAP          PIC X(389).
01 LS-SORT-KEY-A          PIC X(32).
01 LS-SORT-KEY-B          PIC X(32).
01 LS-DATE-OP             PIC X(12).
01 LS-ICAL-END-DATE       PIC 9(8).
01 LS-TEXT-SLICE          PIC X(100).
LINKAGE SECTION.
01 LK-FORMAT              PIC X(12).
COPY "appointment-service-request.cpy".
COPY "appointment-service-result.cpy".
COPY "appointment-config.cpy".
PROCEDURE DIVISION USING LK-FORMAT APPOINTMENT-SERVICE-REQUEST
    APPOINTMENT-SERVICE-RESULT APPOINTMENT-CONFIG.
    EVALUATE FUNCTION TRIM(LK-FORMAT)
      WHEN "PRINT" MOVE AC-PRINT-FILE TO LS-OUTPUT-PATH
      WHEN "PRINT-LIST" MOVE AC-LIST-PRINT-FILE TO LS-OUTPUT-PATH
      WHEN "CSV" MOVE AC-CSV-FILE TO LS-OUTPUT-PATH
      WHEN "ICAL" MOVE AC-ICAL-FILE TO LS-OUTPUT-PATH
      WHEN OTHER
        MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
        MOVE "Unknown export format" TO ASO-MESSAGE
        GOBACK
    END-EVALUATE
    INITIALIZE LS-TEMP-PATH
    STRING FUNCTION TRIM(LS-OUTPUT-PATH) ".tmp" INTO LS-TEMP-PATH END-STRING
    IF FUNCTION TRIM(LK-FORMAT) = "PRINT"
      PERFORM CREATE-CALENDAR-PRINT
      GOBACK
    END-IF
    IF FUNCTION TRIM(LK-FORMAT) = "PRINT-LIST"
      PERFORM CREATE-APPOINTMENT-LIST-PRINT
      GOBACK
    END-IF
    OPEN OUTPUT EXPORT-FILE
    IF LS-FS NOT = "00"
      MOVE APPT-IO-ERROR TO ASO-STATUS-CODE
      MOVE "Export temporary file could not be opened" TO ASO-MESSAGE
      GOBACK
    END-IF
    PERFORM WRITE-HEADER
    MOVE "OPEN-SCAN" TO ARR-OPERATION
    PERFORM REPOSITORY-CALL
    IF ARR-STATUS-CODE NOT = APPT-OK
      CLOSE EXPORT-FILE
      MOVE ARR-STATUS-CODE TO ASO-STATUS-CODE MOVE ARR-MESSAGE TO ASO-MESSAGE
      GOBACK
    END-IF
    PERFORM UNTIL ARR-STATUS-CODE NOT = APPT-OK
      MOVE "NEXT-SCAN" TO ARR-OPERATION
      PERFORM REPOSITORY-CALL
      IF ARR-STATUS-CODE = APPT-OK
        PERFORM MATCH-AND-WRITE
      END-IF
    END-PERFORM
    IF ARR-STATUS-CODE NOT = APPT-NOT-FOUND
      CLOSE EXPORT-FILE
      MOVE ARR-STATUS-CODE TO ASO-STATUS-CODE MOVE ARR-MESSAGE TO ASO-MESSAGE
      MOVE "CLOSE-SCAN" TO ARR-OPERATION PERFORM REPOSITORY-CALL
      GOBACK
    END-IF
    MOVE "CLOSE-SCAN" TO ARR-OPERATION PERFORM REPOSITORY-CALL
    PERFORM WRITE-FOOTER
    CLOSE EXPORT-FILE
    CALL "CBL_RENAME_FILE" USING LS-TEMP-PATH LS-OUTPUT-PATH RETURNING LS-RETURN
    IF LS-RETURN NOT = 0
      MOVE APPT-IO-ERROR TO ASO-STATUS-CODE
      MOVE "Export could not be installed atomically" TO ASO-MESSAGE
    ELSE
      MOVE APPT-OK TO ASO-STATUS-CODE
      MOVE LS-COUNT TO ASO-COUNT
      MOVE LS-OUTPUT-PATH TO ASO-OUTPUT-PATH
      MOVE "Export created" TO ASO-MESSAGE
    END-IF
    GOBACK.

CREATE-CALENDAR-PRINT.
    PERFORM PREPARE-CALENDAR-RANGE
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    PERFORM LOAD-CALENDAR-APPOINTMENTS
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    PERFORM SORT-CALENDAR-APPOINTMENTS
    MOVE X"0D" TO PRINT-CR
    MOVE X"0A" TO PRINT-LF
    OPEN OUTPUT PRINT-FILE
    IF LS-PRINT-FS NOT = "00"
      MOVE APPT-IO-ERROR TO ASO-STATUS-CODE
      MOVE "Print temporary file could not be opened" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    MOVE ZERO TO LS-PAGE-NUMBER LS-BLOCK-ERRORS
    PERFORM VARYING LS-EXPORT-YEAR FROM LS-FIRST-YEAR BY 1
      UNTIL LS-EXPORT-YEAR > LS-LAST-YEAR
        OR ASO-STATUS-CODE NOT = APPT-OK
      MOVE "N" TO LS-CONTINUATION
      PERFORM START-CALENDAR-PAGE
      PERFORM FIND-LAST-ISO-WEEK
      PERFORM VARYING LS-WEEK FROM 1 BY 1
        UNTIL LS-WEEK > LS-LAST-WEEK
          OR ASO-STATUS-CODE NOT = APPT-OK
        PERFORM PRINT-CALENDAR-WEEK
      END-PERFORM
      IF ASO-STATUS-CODE = APPT-OK
        IF LS-EXPORT-YEAR = LS-LAST-YEAR
          MOVE "Y" TO LS-FINAL-PAGE
        ELSE
          MOVE "N" TO LS-FINAL-PAGE
        END-IF
        PERFORM FINISH-CALENDAR-PAGE
        MOVE "N" TO LS-FINAL-PAGE
      END-IF
    END-PERFORM
    CLOSE PRINT-FILE
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    IF LS-BLOCK-ERRORS NOT = ZERO
      MOVE APPT-INTERNAL-ERROR TO ASO-STATUS-CODE
      MOVE "Calendar print validation detected invalid page geometry" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    CALL "CBL_RENAME_FILE" USING LS-TEMP-PATH LS-OUTPUT-PATH RETURNING LS-RETURN
    IF LS-RETURN NOT = 0
      MOVE APPT-IO-ERROR TO ASO-STATUS-CODE
      MOVE "Print export could not be installed atomically" TO ASO-MESSAGE
    ELSE
      MOVE APPT-OK TO ASO-STATUS-CODE
      MOVE LS-PRINT-COUNT TO ASO-COUNT
      MOVE LS-OUTPUT-PATH TO ASO-OUTPUT-PATH
      STRING "Calendar export created: " LS-PAGE-NUMBER " page(s)"
        INTO ASO-MESSAGE
      END-STRING
    END-IF.

CREATE-APPOINTMENT-LIST-PRINT.
    PERFORM PREPARE-CALENDAR-RANGE
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    PERFORM LOAD-CALENDAR-APPOINTMENTS
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    PERFORM SORT-CALENDAR-APPOINTMENTS
    MOVE X"0D" TO PRINT-CR
    MOVE X"0A" TO PRINT-LF
    OPEN OUTPUT PRINT-FILE
    IF LS-PRINT-FS NOT = "00"
      MOVE APPT-IO-ERROR TO ASO-STATUS-CODE
      MOVE "Appointment-list temporary file could not be opened"
        TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    MOVE ZERO TO LS-PAGE-NUMBER LS-BLOCK-ERRORS
    MOVE "N" TO LS-CONTINUATION
    PERFORM START-APPOINTMENT-LIST-PAGE
    IF LS-PRINT-COUNT = ZERO
      MOVE SPACES TO PRINT-TEXT
      MOVE "NO ACTIVE APPOINTMENTS IN THE SELECTED RANGE" TO PRINT-TEXT
      PERFORM WRITE-CALENDAR-LINE
    END-IF
    PERFORM VARYING LS-PRINT-INDEX FROM 1 BY 1
      UNTIL LS-PRINT-INDEX > LS-PRINT-COUNT
        OR ASO-STATUS-CODE NOT = APPT-OK
      MOVE LS-PRINT-ENTRY(LS-PRINT-INDEX) TO APPOINTMENT-RECORD
      PERFORM PREPARE-APPOINTMENT-LIST-BLOCK
      PERFORM ENSURE-APPOINTMENT-LIST-BLOCK-FITS
      PERFORM WRITE-APPOINTMENT-LIST-BLOCK
    END-PERFORM
    IF ASO-STATUS-CODE = APPT-OK
      MOVE "Y" TO LS-FINAL-PAGE
      PERFORM FINISH-APPOINTMENT-LIST-PAGE
      MOVE "N" TO LS-FINAL-PAGE
    END-IF
    CLOSE PRINT-FILE
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    IF LS-BLOCK-ERRORS NOT = ZERO
      MOVE APPT-INTERNAL-ERROR TO ASO-STATUS-CODE
      MOVE "List validation detected a split appointment block"
        TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    CALL "CBL_RENAME_FILE" USING LS-TEMP-PATH LS-OUTPUT-PATH RETURNING LS-RETURN
    IF LS-RETURN NOT = 0
      MOVE APPT-IO-ERROR TO ASO-STATUS-CODE
      MOVE "Appointment-list export could not be installed atomically"
        TO ASO-MESSAGE
    ELSE
      MOVE APPT-OK TO ASO-STATUS-CODE
      MOVE LS-PRINT-COUNT TO ASO-COUNT
      MOVE LS-OUTPUT-PATH TO ASO-OUTPUT-PATH
      STRING "Appointment-list export created: " LS-PAGE-NUMBER
        " page(s)" INTO ASO-MESSAGE
      END-STRING
    END-IF.

PREPARE-CALENDAR-RANGE.
    MOVE APPT-OK TO ASO-STATUS-CODE
    INITIALIZE LS-CALENDAR-DATA
    IF ASR-FROM-DATE > ZERO
      MOVE ASR-FROM-DATE(1:4) TO LS-FIRST-YEAR
    ELSE
      MOVE FUNCTION CURRENT-DATE TO LS-TODAY-RAW
      MOVE LS-TODAY-RAW(1:4) TO LS-FIRST-YEAR
    END-IF
    IF ASR-TO-DATE > ZERO
      MOVE ASR-TO-DATE(1:4) TO LS-LAST-YEAR
    ELSE
      MOVE LS-FIRST-YEAR TO LS-LAST-YEAR
    END-IF
    IF ASR-FROM-DATE > ZERO
      MOVE ASR-FROM-DATE TO LS-RANGE-START
    ELSE
      COMPUTE LS-RANGE-START = (LS-FIRST-YEAR * 10000) + 101
    END-IF
    IF ASR-TO-DATE > ZERO
      MOVE ASR-TO-DATE TO LS-RANGE-END
    ELSE
      COMPUTE LS-RANGE-END = (LS-LAST-YEAR * 10000) + 1231
    END-IF
    IF LS-FIRST-YEAR < 1601 OR LS-LAST-YEAR < LS-FIRST-YEAR
      OR LS-LAST-YEAR - LS-FIRST-YEAR > 99
      MOVE APPT-INVALID-DATE TO ASO-STATUS-CODE
      MOVE "Print export requires a valid range of at most 100 years"
        TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    IF AC-LINES-PER-PAGE < 20
      MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
      MOVE "Print page length must be at least 20 lines" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    COMPUTE LS-LAST-CONTENT = AC-LINES-PER-PAGE - 2
    MOVE FUNCTION CURRENT-DATE TO LS-TODAY-RAW
    STRING LS-TODAY-RAW(7:2) "." LS-TODAY-RAW(5:2) "."
      LS-TODAY-RAW(1:4) INTO LS-DATE-LONG
    END-STRING.

LOAD-CALENDAR-APPOINTMENTS.
    MOVE ZERO TO LS-PRINT-COUNT
    MOVE "OPEN-SCAN" TO ARR-OPERATION
    PERFORM REPOSITORY-CALL
    IF ARR-STATUS-CODE NOT = APPT-OK
      MOVE ARR-STATUS-CODE TO ASO-STATUS-CODE
      MOVE ARR-MESSAGE TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    PERFORM UNTIL ARR-STATUS-CODE NOT = APPT-OK
      MOVE "NEXT-SCAN" TO ARR-OPERATION
      PERFORM REPOSITORY-CALL
      IF ARR-STATUS-CODE = APPT-OK
        IF AR-STATUS = "A" AND
          ((FUNCTION TRIM(LK-FORMAT) = "PRINT"
            AND AR-ISO-YEAR >= LS-FIRST-YEAR
            AND AR-ISO-YEAR <= LS-LAST-YEAR)
           OR (FUNCTION TRIM(LK-FORMAT) = "PRINT-LIST"
            AND AR-END-DATE >= LS-RANGE-START
            AND AR-START-DATE <= LS-RANGE-END))
          IF LS-PRINT-COUNT < 5000
            ADD 1 TO LS-PRINT-COUNT
            MOVE APPOINTMENT-RECORD TO LS-PRINT-ENTRY(LS-PRINT-COUNT)
          ELSE
            MOVE APPT-INTERNAL-ERROR TO ASO-STATUS-CODE
            MOVE "Print export is limited to 5000 appointments"
              TO ASO-MESSAGE
          END-IF
        END-IF
      END-IF
    END-PERFORM
    MOVE ARR-STATUS-CODE TO LS-STATUS
    MOVE ARR-MESSAGE TO LS-MESSAGE
    MOVE "CLOSE-SCAN" TO ARR-OPERATION
    PERFORM REPOSITORY-CALL
    IF ASO-STATUS-CODE NOT = APPT-OK EXIT PARAGRAPH END-IF
    IF LS-STATUS = APPT-NOT-FOUND
      MOVE APPT-OK TO ASO-STATUS-CODE
    ELSE
      MOVE LS-STATUS TO ASO-STATUS-CODE
      MOVE LS-MESSAGE TO ASO-MESSAGE
    END-IF.

SORT-CALENDAR-APPOINTMENTS.
    PERFORM VARYING LS-SORT-I FROM 1 BY 1
      UNTIL LS-SORT-I >= LS-PRINT-COUNT
      PERFORM VARYING LS-SORT-J FROM LS-SORT-I BY 1
        UNTIL LS-SORT-J >= LS-PRINT-COUNT
        INITIALIZE LS-SORT-KEY-A LS-SORT-KEY-B
        STRING LS-PRINT-ENTRY(LS-SORT-I)(37:6)
          LS-PRINT-ENTRY(LS-SORT-I)(21:8)
          LS-PRINT-ENTRY(LS-SORT-I)(3:9)
          INTO LS-SORT-KEY-A
        END-STRING
        STRING LS-PRINT-ENTRY(LS-SORT-J + 1)(37:6)
          LS-PRINT-ENTRY(LS-SORT-J + 1)(21:8)
          LS-PRINT-ENTRY(LS-SORT-J + 1)(3:9)
          INTO LS-SORT-KEY-B
        END-STRING
        IF LS-SORT-KEY-A > LS-SORT-KEY-B
          MOVE LS-PRINT-ENTRY(LS-SORT-I) TO LS-PRINT-SWAP
          MOVE LS-PRINT-ENTRY(LS-SORT-J + 1)
            TO LS-PRINT-ENTRY(LS-SORT-I)
          MOVE LS-PRINT-SWAP TO LS-PRINT-ENTRY(LS-SORT-J + 1)
        END-IF
      END-PERFORM
    END-PERFORM.

FIND-LAST-ISO-WEEK.
    INITIALIZE APPOINTMENT-DATE-PARAMS
    COMPUTE ADP-INPUT-DATE = (LS-EXPORT-YEAR * 10000) + 1228
    MOVE "ISO" TO LS-DATE-OP
    CALL "APPOINTMENT-DATES" USING LS-DATE-OP
      APPOINTMENT-DATE-PARAMS LS-STATUS
    IF LS-STATUS = APPT-OK
      MOVE ADP-ISO-WEEK TO LS-LAST-WEEK
    ELSE
      MOVE 52 TO LS-LAST-WEEK
    END-IF.

PRINT-CALENDAR-WEEK.
    MOVE "N" TO LS-WEEK-HAS-APPTS
    PERFORM VARYING LS-PRINT-INDEX FROM 1 BY 1
      UNTIL LS-PRINT-INDEX > LS-PRINT-COUNT
        OR ASO-STATUS-CODE NOT = APPT-OK
      MOVE LS-PRINT-ENTRY(LS-PRINT-INDEX) TO APPOINTMENT-RECORD
      IF AR-ISO-YEAR = LS-EXPORT-YEAR AND AR-ISO-WEEK = LS-WEEK
        PERFORM PREPARE-CALENDAR-BLOCK
        PERFORM ENSURE-CALENDAR-BLOCK-FITS
        PERFORM WRITE-CALENDAR-BLOCK
        MOVE "Y" TO LS-WEEK-HAS-APPTS
      END-IF
    END-PERFORM
    IF LS-WEEK-HAS-APPTS = "N" AND ASO-STATUS-CODE = APPT-OK
      IF LS-LINE-NUMBER + 1 > LS-LAST-CONTENT
        MOVE "N" TO LS-FINAL-PAGE
        PERFORM FINISH-CALENDAR-PAGE
        MOVE "Y" TO LS-CONTINUATION
        PERFORM START-CALENDAR-PAGE
      END-IF
      MOVE SPACES TO PRINT-TEXT
      MOVE LS-WEEK TO LS-WEEK-DISPLAY
      MOVE LS-WEEK-DISPLAY TO PRINT-TEXT(1:2)
      PERFORM WRITE-CALENDAR-LINE
    END-IF.

PREPARE-CALENDAR-BLOCK.
    INITIALIZE LS-WRAP-TABLE
    MOVE ZERO TO LS-WRAP-COUNT
    MOVE FUNCTION UPPER-CASE(AR-CLIENT(1:16)) TO LS-PRINT-CLIENT
    MOVE FUNCTION UPPER-CASE(AR-SUBJECT) TO LS-SUBJECT-UPPER
    MOVE LS-SUBJECT-UPPER TO LS-REMAINING-TEXT
    PERFORM UNTIL LS-REMAINING-TEXT = SPACES OR LS-WRAP-COUNT = 10
      COMPUTE LS-TEXT-LENGTH =
        FUNCTION STORED-CHAR-LENGTH(LS-REMAINING-TEXT)
      IF LS-TEXT-LENGTH <= 43
        ADD 1 TO LS-WRAP-COUNT
        MOVE LS-REMAINING-TEXT(1:43) TO LS-WRAP-LINE(LS-WRAP-COUNT)
        MOVE SPACES TO LS-REMAINING-TEXT
      ELSE
        MOVE 43 TO LS-CUT-POSITION LS-SEARCH-POSITION
        PERFORM UNTIL LS-SEARCH-POSITION <= 1
          OR LS-REMAINING-TEXT(LS-SEARCH-POSITION:1) = SPACE
          SUBTRACT 1 FROM LS-SEARCH-POSITION
        END-PERFORM
        IF LS-SEARCH-POSITION > 1
          MOVE LS-SEARCH-POSITION TO LS-CUT-POSITION
        END-IF
        ADD 1 TO LS-WRAP-COUNT
        MOVE LS-REMAINING-TEXT(1:LS-CUT-POSITION)
          TO LS-WRAP-LINE(LS-WRAP-COUNT)
        COMPUTE LS-START-POSITION = LS-CUT-POSITION + 1
        PERFORM UNTIL LS-START-POSITION > LS-TEXT-LENGTH
          OR LS-REMAINING-TEXT(LS-START-POSITION:1) NOT = SPACE
          ADD 1 TO LS-START-POSITION
        END-PERFORM
        MOVE SPACES TO LS-TEXT-SLICE
        IF LS-START-POSITION <= LS-TEXT-LENGTH
          COMPUTE LS-REMAINING-LENGTH =
            LS-TEXT-LENGTH - LS-START-POSITION + 1
          MOVE LS-REMAINING-TEXT(
            LS-START-POSITION:LS-REMAINING-LENGTH)
            TO LS-TEXT-SLICE
        END-IF
        MOVE LS-TEXT-SLICE TO LS-REMAINING-TEXT
      END-IF
    END-PERFORM
    IF LS-WRAP-COUNT = ZERO MOVE 1 TO LS-WRAP-COUNT END-IF.

ENSURE-CALENDAR-BLOCK-FITS.
    IF LS-LINE-NUMBER + LS-WRAP-COUNT > LS-LAST-CONTENT
      MOVE "N" TO LS-FINAL-PAGE
      PERFORM FINISH-CALENDAR-PAGE
      MOVE "Y" TO LS-CONTINUATION
      PERFORM START-CALENDAR-PAGE
      MOVE "N" TO LS-WEEK-HAS-APPTS
    END-IF
    IF LS-LINE-NUMBER + LS-WRAP-COUNT > LS-LAST-CONTENT
      ADD 1 TO LS-BLOCK-ERRORS
    END-IF.

WRITE-CALENDAR-BLOCK.
    MOVE LS-PAGE-NUMBER TO LS-BLOCK-START-PAGE
    MOVE LS-LINE-NUMBER TO LS-BLOCK-START-LINE
    STRING AR-START-DATE(7:2) "." AR-START-DATE(5:2) ".-"
      AR-END-DATE(7:2) "." AR-END-DATE(5:2) "."
      INTO LS-DATE-RANGE
    END-STRING
    PERFORM VARYING LS-WRAP-INDEX FROM 1 BY 1
      UNTIL LS-WRAP-INDEX > LS-WRAP-COUNT
        OR ASO-STATUS-CODE NOT = APPT-OK
      MOVE SPACES TO PRINT-TEXT
      IF LS-WRAP-INDEX = 1
        IF LS-WEEK-HAS-APPTS = "N"
          MOVE LS-WEEK TO LS-WEEK-DISPLAY
          MOVE LS-WEEK-DISPLAY TO PRINT-TEXT(1:2)
        END-IF
        MOVE LS-DATE-RANGE TO PRINT-TEXT(5:13)
        MOVE LS-PRINT-CLIENT TO PRINT-TEXT(20:16)
      END-IF
      MOVE LS-WRAP-LINE(LS-WRAP-INDEX) TO PRINT-TEXT(38:43)
      PERFORM WRITE-CALENDAR-LINE
    END-PERFORM
    COMPUTE LS-WRITTEN-LINES = LS-LINE-NUMBER - LS-BLOCK-START-LINE
    IF LS-PAGE-NUMBER NOT = LS-BLOCK-START-PAGE
      OR LS-LINE-NUMBER > LS-LAST-CONTENT
      OR LS-WRITTEN-LINES NOT = LS-WRAP-COUNT
      ADD 1 TO LS-BLOCK-ERRORS
    END-IF.

PREPARE-APPOINTMENT-LIST-BLOCK.
    INITIALIZE LS-WRAP-TABLE
    MOVE ZERO TO LS-WRAP-COUNT
    MOVE FUNCTION UPPER-CASE(AR-CLIENT(1:16)) TO LS-PRINT-CLIENT
    MOVE FUNCTION UPPER-CASE(AR-SUBJECT) TO LS-SUBJECT-UPPER
    MOVE LS-SUBJECT-UPPER TO LS-REMAINING-TEXT
    PERFORM UNTIL LS-REMAINING-TEXT = SPACES OR LS-WRAP-COUNT = 10
      COMPUTE LS-TEXT-LENGTH =
        FUNCTION STORED-CHAR-LENGTH(LS-REMAINING-TEXT)
      IF LS-TEXT-LENGTH <= 31
        ADD 1 TO LS-WRAP-COUNT
        MOVE LS-REMAINING-TEXT(1:31) TO LS-WRAP-LINE(LS-WRAP-COUNT)
        MOVE SPACES TO LS-REMAINING-TEXT
      ELSE
        MOVE 31 TO LS-CUT-POSITION LS-SEARCH-POSITION
        PERFORM UNTIL LS-SEARCH-POSITION <= 1
          OR LS-REMAINING-TEXT(LS-SEARCH-POSITION:1) = SPACE
          SUBTRACT 1 FROM LS-SEARCH-POSITION
        END-PERFORM
        IF LS-SEARCH-POSITION > 1
          MOVE LS-SEARCH-POSITION TO LS-CUT-POSITION
        END-IF
        ADD 1 TO LS-WRAP-COUNT
        MOVE LS-REMAINING-TEXT(1:LS-CUT-POSITION)
          TO LS-WRAP-LINE(LS-WRAP-COUNT)
        COMPUTE LS-START-POSITION = LS-CUT-POSITION + 1
        PERFORM UNTIL LS-START-POSITION > LS-TEXT-LENGTH
          OR LS-REMAINING-TEXT(LS-START-POSITION:1) NOT = SPACE
          ADD 1 TO LS-START-POSITION
        END-PERFORM
        MOVE SPACES TO LS-TEXT-SLICE
        IF LS-START-POSITION <= LS-TEXT-LENGTH
          COMPUTE LS-REMAINING-LENGTH =
            LS-TEXT-LENGTH - LS-START-POSITION + 1
          MOVE LS-REMAINING-TEXT(
            LS-START-POSITION:LS-REMAINING-LENGTH)
            TO LS-TEXT-SLICE
        END-IF
        MOVE LS-TEXT-SLICE TO LS-REMAINING-TEXT
      END-IF
    END-PERFORM
    IF LS-WRAP-COUNT = ZERO MOVE 1 TO LS-WRAP-COUNT END-IF.

ENSURE-APPOINTMENT-LIST-BLOCK-FITS.
    IF LS-LINE-NUMBER + LS-WRAP-COUNT > LS-LAST-CONTENT
      MOVE "N" TO LS-FINAL-PAGE
      PERFORM FINISH-APPOINTMENT-LIST-PAGE
      MOVE "Y" TO LS-CONTINUATION
      PERFORM START-APPOINTMENT-LIST-PAGE
    END-IF
    IF LS-LINE-NUMBER + LS-WRAP-COUNT > LS-LAST-CONTENT
      ADD 1 TO LS-BLOCK-ERRORS
    END-IF.

WRITE-APPOINTMENT-LIST-BLOCK.
    MOVE LS-PAGE-NUMBER TO LS-BLOCK-START-PAGE
    MOVE LS-LINE-NUMBER TO LS-BLOCK-START-LINE
    STRING AR-START-DATE(7:2) "." AR-START-DATE(5:2) "."
      AR-START-DATE(1:4) INTO LS-DATE-DISPLAY
    END-STRING
    STRING AR-START-DATE(7:2) "." AR-START-DATE(5:2) ".-"
      AR-END-DATE(7:2) "." AR-END-DATE(5:2) "."
      INTO LS-DATE-RANGE
    END-STRING
    PERFORM VARYING LS-WRAP-INDEX FROM 1 BY 1
      UNTIL LS-WRAP-INDEX > LS-WRAP-COUNT
        OR ASO-STATUS-CODE NOT = APPT-OK
      MOVE SPACES TO PRINT-TEXT
      IF LS-WRAP-INDEX = 1
        MOVE AR-ISO-WEEK TO LS-WEEK-DISPLAY
        MOVE LS-WEEK-DISPLAY TO PRINT-TEXT(1:2)
        MOVE LS-DATE-DISPLAY TO PRINT-TEXT(5:10)
        MOVE LS-DATE-RANGE TO PRINT-TEXT(17:13)
        MOVE LS-PRINT-CLIENT TO PRINT-TEXT(32:16)
      END-IF
      MOVE LS-WRAP-LINE(LS-WRAP-INDEX)(1:31) TO PRINT-TEXT(50:31)
      PERFORM WRITE-CALENDAR-LINE
    END-PERFORM
    COMPUTE LS-WRITTEN-LINES = LS-LINE-NUMBER - LS-BLOCK-START-LINE
    IF LS-PAGE-NUMBER NOT = LS-BLOCK-START-PAGE
      OR LS-LINE-NUMBER > LS-LAST-CONTENT
      OR LS-WRITTEN-LINES NOT = LS-WRAP-COUNT
      ADD 1 TO LS-BLOCK-ERRORS
    END-IF.

START-CALENDAR-PAGE.
    ADD 1 TO LS-PAGE-NUMBER
    MOVE ZERO TO LS-LINE-NUMBER
    IF LS-PAGE-NUMBER = 1 MOVE ZERO TO LS-TOP-MARGIN
      ELSE MOVE 1 TO LS-TOP-MARGIN END-IF
    PERFORM VARYING LS-MARGIN-INDEX FROM 1 BY 1
      UNTIL LS-MARGIN-INDEX > LS-TOP-MARGIN
      MOVE SPACES TO PRINT-TEXT
      PERFORM WRITE-CALENDAR-LINE
    END-PERFORM
    MOVE LS-PAGE-NUMBER TO LS-PAGE-DISPLAY
    MOVE LS-EXPORT-YEAR TO LS-YEAR-DISPLAY
    MOVE SPACES TO PRINT-TEXT
    MOVE "CALENDAR MANAGEMENT SYSTEM" TO PRINT-TEXT(1:29)
    MOVE "REPORT CALR01" TO PRINT-TEXT(47:13)
    MOVE "PAGE" TO PRINT-TEXT(68:4)
    MOVE LS-PAGE-DISPLAY TO PRINT-TEXT(74:3)
    PERFORM WRITE-CALENDAR-LINE
    MOVE SPACES TO PRINT-TEXT
    STRING "APPOINTMENT CALENDAR " LS-YEAR-DISPLAY
      INTO PRINT-TEXT
    END-STRING
    MOVE "RUN DATE" TO PRINT-TEXT(47:8)
    MOVE LS-DATE-LONG TO PRINT-TEXT(57:10)
    IF LS-CONTINUATION = "Y"
      MOVE "CONTINUED" TO PRINT-TEXT(70:9)
    END-IF
    PERFORM WRITE-CALENDAR-LINE
    MOVE ALL "=" TO PRINT-TEXT
    PERFORM WRITE-CALENDAR-LINE
    MOVE SPACES TO PRINT-TEXT
    STRING "YEAR PLAN " LS-YEAR-DISPLAY
      " / ACTIVE APPOINTMENTS BY ISO WEEK"
      INTO PRINT-TEXT
    END-STRING
    PERFORM WRITE-CALENDAR-LINE
    MOVE "WK  RANGE          CLIENT            APPOINTMENT / SUBJECT" TO PRINT-TEXT
    PERFORM WRITE-CALENDAR-LINE
    MOVE ALL "-" TO PRINT-TEXT
    PERFORM WRITE-CALENDAR-LINE.

START-APPOINTMENT-LIST-PAGE.
    ADD 1 TO LS-PAGE-NUMBER
    MOVE ZERO TO LS-LINE-NUMBER
    IF LS-PAGE-NUMBER = 1 MOVE ZERO TO LS-TOP-MARGIN
      ELSE MOVE 1 TO LS-TOP-MARGIN END-IF
    PERFORM VARYING LS-MARGIN-INDEX FROM 1 BY 1
      UNTIL LS-MARGIN-INDEX > LS-TOP-MARGIN
      MOVE SPACES TO PRINT-TEXT
      PERFORM WRITE-CALENDAR-LINE
    END-PERFORM
    MOVE LS-PAGE-NUMBER TO LS-PAGE-DISPLAY
    MOVE SPACES TO PRINT-TEXT
    MOVE "CALENDAR MANAGEMENT SYSTEM" TO PRINT-TEXT(1:29)
    MOVE "REPORT CALR02" TO PRINT-TEXT(47:13)
    MOVE "PAGE" TO PRINT-TEXT(68:4)
    MOVE LS-PAGE-DISPLAY TO PRINT-TEXT(74:3)
    PERFORM WRITE-CALENDAR-LINE
    MOVE SPACES TO PRINT-TEXT
    STRING "APPOINTMENT LIST " LS-FIRST-YEAR "-" LS-LAST-YEAR
      INTO PRINT-TEXT
    END-STRING
    MOVE "RUN DATE" TO PRINT-TEXT(47:8)
    MOVE LS-DATE-LONG TO PRINT-TEXT(57:10)
    IF LS-CONTINUATION = "Y"
      MOVE "CONTINUED" TO PRINT-TEXT(70:9)
    END-IF
    PERFORM WRITE-CALENDAR-LINE
    MOVE ALL "=" TO PRINT-TEXT
    PERFORM WRITE-CALENDAR-LINE
    MOVE SPACES TO PRINT-TEXT
    MOVE "ACTIVE APPOINTMENTS / WRAPPED SUBJECT LINES" TO PRINT-TEXT
    PERFORM WRITE-CALENDAR-LINE
    MOVE "WK  DATE        RANGE          CLIENT            APPOINTMENT / SUBJECT"
      TO PRINT-TEXT
    PERFORM WRITE-CALENDAR-LINE
    MOVE ALL "-" TO PRINT-TEXT
    PERFORM WRITE-CALENDAR-LINE.

FINISH-APPOINTMENT-LIST-PAGE.
    PERFORM UNTIL LS-LINE-NUMBER = LS-LAST-CONTENT
      MOVE SPACES TO PRINT-TEXT
      PERFORM WRITE-CALENDAR-LINE
    END-PERFORM
    MOVE SPACES TO PRINT-TEXT
    IF LS-FINAL-PAGE = "Y"
      MOVE "*** END OF REPORT CALR02 ***" TO PRINT-TEXT
    END-IF
    PERFORM WRITE-CALENDAR-LINE
    MOVE SPACES TO PRINT-TEXT
    PERFORM WRITE-CALENDAR-LINE
    IF LS-LINE-NUMBER NOT = AC-LINES-PER-PAGE
      ADD 1 TO LS-BLOCK-ERRORS
    END-IF.

FINISH-CALENDAR-PAGE.
    PERFORM UNTIL LS-LINE-NUMBER = LS-LAST-CONTENT
      MOVE SPACES TO PRINT-TEXT
      PERFORM WRITE-CALENDAR-LINE
    END-PERFORM
    MOVE SPACES TO PRINT-TEXT
    IF LS-FINAL-PAGE = "Y"
      MOVE "*** END OF REPORT CALR01 ***" TO PRINT-TEXT
    END-IF
    PERFORM WRITE-CALENDAR-LINE
    MOVE SPACES TO PRINT-TEXT
    PERFORM WRITE-CALENDAR-LINE
    IF LS-LINE-NUMBER NOT = AC-LINES-PER-PAGE
      ADD 1 TO LS-BLOCK-ERRORS
    END-IF.

WRITE-CALENDAR-LINE.
    WRITE PRINT-RECORD
    IF LS-PRINT-FS NOT = "00"
      MOVE APPT-IO-ERROR TO ASO-STATUS-CODE
      MOVE "Print export write failed" TO ASO-MESSAGE
    ELSE
      ADD 1 TO LS-LINE-NUMBER
    END-IF.

MATCH-AND-WRITE.
    IF ASR-STATUS NOT = SPACE AND AR-STATUS NOT = ASR-STATUS EXIT PARAGRAPH END-IF
    IF ASR-FROM-DATE > 0 AND AR-END-DATE < ASR-FROM-DATE EXIT PARAGRAPH END-IF
    IF ASR-TO-DATE > 0 AND AR-START-DATE > ASR-TO-DATE EXIT PARAGRAPH END-IF
    ADD 1 TO LS-COUNT
    EVALUATE FUNCTION TRIM(LK-FORMAT)
      WHEN "CSV" PERFORM WRITE-CSV
      WHEN "ICAL" PERFORM WRITE-ICAL
    END-EVALUATE.

WRITE-HEADER.
    INITIALIZE EXPORT-LINE
    EVALUATE FUNCTION TRIM(LK-FORMAT)
      WHEN "CSV"
        MOVE "start_date,end_date,client,subject,id,series_id,status,recurrence,series_until,revision"
          TO EXPORT-LINE WRITE EXPORT-LINE
      WHEN "ICAL"
        MOVE "BEGIN:VCALENDAR" TO EXPORT-LINE WRITE EXPORT-LINE
        MOVE "VERSION:2.0" TO EXPORT-LINE WRITE EXPORT-LINE
        MOVE "PRODID:-//CALMGR//EN" TO EXPORT-LINE WRITE EXPORT-LINE
    END-EVALUATE.

WRITE-FOOTER.
    IF FUNCTION TRIM(LK-FORMAT) = "ICAL"
      MOVE "END:VCALENDAR" TO EXPORT-LINE WRITE EXPORT-LINE
    END-IF.

WRITE-CSV.
    INITIALIZE EXPORT-LINE
    STRING AR-START-DATE "," AR-END-DATE
      "," FUNCTION TRIM(AR-CLIENT) "," FUNCTION TRIM(AR-SUBJECT)
      "," AR-ID "," AR-SERIES-ID "," AR-STATUS "," AR-RECURRENCE
      "," AR-SERIES-UNTIL "," AR-REVISION
      INTO EXPORT-LINE END-STRING
    WRITE EXPORT-LINE.

WRITE-ICAL.
    MOVE "BEGIN:VEVENT" TO EXPORT-LINE WRITE EXPORT-LINE
    INITIALIZE EXPORT-LINE STRING "UID:" AR-ID "@calmgr"
      INTO EXPORT-LINE END-STRING WRITE EXPORT-LINE
    INITIALIZE EXPORT-LINE STRING "DTSTART;VALUE=DATE:" AR-START-DATE
      INTO EXPORT-LINE END-STRING WRITE EXPORT-LINE
    COMPUTE LS-ICAL-END-DATE =
      FUNCTION DATE-OF-INTEGER(
        FUNCTION INTEGER-OF-DATE(AR-END-DATE) + 1)
    INITIALIZE EXPORT-LINE STRING "DTEND;VALUE=DATE:" LS-ICAL-END-DATE
      INTO EXPORT-LINE END-STRING WRITE EXPORT-LINE
    INITIALIZE EXPORT-LINE STRING "SUMMARY:" FUNCTION TRIM(AR-SUBJECT)
      INTO EXPORT-LINE END-STRING WRITE EXPORT-LINE
    INITIALIZE EXPORT-LINE STRING "DESCRIPTION:Client: " FUNCTION TRIM(AR-CLIENT)
      INTO EXPORT-LINE END-STRING WRITE EXPORT-LINE
    IF AR-STATUS = "C" MOVE "STATUS:CANCELLED" TO EXPORT-LINE WRITE EXPORT-LINE END-IF
    MOVE "END:VEVENT" TO EXPORT-LINE WRITE EXPORT-LINE.

REPOSITORY-CALL.
    CALL "APPOINTMENT-REPOSITORY" USING APPOINTMENT-REPOSITORY-REQUEST
      APPOINTMENT-RECORD APPOINTMENT-CONFIG.
END PROGRAM APPOINTMENT-EXPORT.

IDENTIFICATION DIVISION.
PROGRAM-ID. APPOINTMENT-CSV-READER.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CSV-IN ASSIGN TO DYNAMIC CR-PATH
      ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS CR-FS.
DATA DIVISION.
FILE SECTION.
FD CSV-IN.
01 CR-LINE                PIC X(1024).
WORKING-STORAGE SECTION.
COPY "appointment-status.cpy".
01 CR-PATH                PIC X(256).
01 CR-FS                  PIC XX.
01 CR-OPEN                PIC X VALUE "N".
LOCAL-STORAGE SECTION.
01 CR-START               PIC X(10).
01 CR-END                 PIC X(10).
01 CR-CLIENT              PIC X(60).
01 CR-SUBJECT             PIC X(100).
LINKAGE SECTION.
01 CR-OPERATION           PIC X(12).
COPY "appointment-service-request.cpy".
01 CR-STATUS              PIC 9(3).
01 CR-MESSAGE             PIC X(160).
PROCEDURE DIVISION USING CR-OPERATION APPOINTMENT-SERVICE-REQUEST
    CR-STATUS CR-MESSAGE.
    MOVE APPT-OK TO CR-STATUS INITIALIZE CR-MESSAGE
    EVALUATE FUNCTION TRIM(CR-OPERATION)
      WHEN "OPEN"
        MOVE ASR-PATH TO CR-PATH OPEN INPUT CSV-IN
        IF CR-FS = "00"
          MOVE "Y" TO CR-OPEN
          READ CSV-IN AT END CONTINUE END-READ
        ELSE
          MOVE APPT-IO-ERROR TO CR-STATUS MOVE "CSV file could not be opened" TO CR-MESSAGE
        END-IF
      WHEN "NEXT"
        IF CR-OPEN NOT = "Y"
          MOVE APPT-INTERNAL-ERROR TO CR-STATUS MOVE "CSV reader is not open" TO CR-MESSAGE
        ELSE
          READ CSV-IN
            AT END MOVE APPT-NOT-FOUND TO CR-STATUS
            NOT AT END
              INITIALIZE CR-START CR-END CR-CLIENT CR-SUBJECT
              UNSTRING CR-LINE DELIMITED BY "," INTO CR-START CR-END CR-CLIENT CR-SUBJECT
              INITIALIZE APPOINTMENT-SERVICE-REQUEST
              MOVE "ADD" TO ASR-OPERATION MOVE "CSV" TO ASR-SOURCE
              MOVE CR-CLIENT TO ASR-CLIENT MOVE CR-SUBJECT TO ASR-SUBJECT
              MOVE "N" TO ASR-RECURRENCE
              IF CR-START(5:1) = "-"
                STRING CR-START(1:4) CR-START(6:2) CR-START(9:2) INTO ASR-START-DATE END-STRING
                STRING CR-END(1:4) CR-END(6:2) CR-END(9:2) INTO ASR-END-DATE END-STRING
              ELSE
                MOVE CR-START(1:8) TO ASR-START-DATE MOVE CR-END(1:8) TO ASR-END-DATE
              END-IF
          END-READ
        END-IF
      WHEN "CLOSE"
        IF CR-OPEN = "Y" CLOSE CSV-IN MOVE "N" TO CR-OPEN END-IF
      WHEN OTHER MOVE APPT-INVALID-REQUEST TO CR-STATUS
    END-EVALUATE
    GOBACK.
END PROGRAM APPOINTMENT-CSV-READER.
