>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. APPOINTMENT-REPOSITORY.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "appointment-status.cpy".
01 WS-DATA-FILE            PIC X(256).
01 WS-SAFETY-FILE          PIC X(256).
01 WS-ID                   PIC X(9).
01 WS-STATUS               PIC 9(3).
01 WS-MESSAGE              PIC X(160).
LINKAGE SECTION.
COPY "appointment-repository-request.cpy".
01 LK-APPOINTMENT-RECORD PIC X(389).
COPY "appointment-config.cpy".
PROCEDURE DIVISION USING APPOINTMENT-REPOSITORY-REQUEST
    LK-APPOINTMENT-RECORD APPOINTMENT-CONFIG.
    MOVE AC-DATA-FILE TO WS-DATA-FILE
    MOVE AC-SAFETY-FILE TO WS-SAFETY-FILE
    MOVE ARR-ID TO WS-ID
    MOVE APPT-OK TO WS-STATUS
    INITIALIZE WS-MESSAGE
    EVALUATE FUNCTION TRIM(ARR-OPERATION)
      WHEN "ENSURE"
        CALL "appt_db_ensure" USING WS-DATA-FILE WS-STATUS WS-MESSAGE
      WHEN "FORCE-INIT"
        CALL "appt_db_reset" USING WS-DATA-FILE WS-SAFETY-FILE
          WS-STATUS WS-MESSAGE
      WHEN "GET"
        CALL "appt_db_get" USING WS-DATA-FILE WS-ID LK-APPOINTMENT-RECORD
          WS-STATUS WS-MESSAGE
      WHEN "PUT"
        CALL "appt_db_put" USING WS-DATA-FILE LK-APPOINTMENT-RECORD
          WS-STATUS WS-MESSAGE
      WHEN "UPDATE"
        CALL "appt_db_update" USING WS-DATA-FILE LK-APPOINTMENT-RECORD
          WS-STATUS WS-MESSAGE
      WHEN "DELETE"
        CALL "appt_db_delete" USING WS-DATA-FILE WS-ID WS-STATUS WS-MESSAGE
      WHEN "OPEN-SCAN"
        CALL "appt_db_scan_open" USING WS-STATUS WS-MESSAGE
      WHEN "NEXT-SCAN"
        CALL "appt_db_scan_next" USING WS-DATA-FILE LK-APPOINTMENT-RECORD
          WS-STATUS WS-MESSAGE
      WHEN "CLOSE-SCAN"
        CALL "appt_db_scan_close" USING WS-STATUS WS-MESSAGE
      WHEN "BEGIN"
        CALL "appt_db_begin" USING WS-DATA-FILE WS-STATUS WS-MESSAGE
      WHEN "COMMIT"
        CALL "appt_db_commit" USING WS-STATUS WS-MESSAGE
      WHEN "ROLLBACK"
        CALL "appt_db_rollback" USING WS-STATUS WS-MESSAGE
      WHEN OTHER
        MOVE APPT-INVALID-REQUEST TO WS-STATUS
        MOVE "Unknown repository operation" TO WS-MESSAGE
    END-EVALUATE
    MOVE WS-STATUS TO ARR-STATUS-CODE
    MOVE WS-MESSAGE TO ARR-MESSAGE
    GOBACK.
END PROGRAM APPOINTMENT-REPOSITORY.
