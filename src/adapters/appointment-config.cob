>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. APPOINTMENT-CONFIG-ADAPTER.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CONFIG-FILE ASSIGN TO DYNAMIC LS-CONFIG-PATH
      ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS LS-FS.
DATA DIVISION.
FILE SECTION.
FD CONFIG-FILE.
01 CONFIG-LINE             PIC X(512).
WORKING-STORAGE SECTION.
COPY "appointment-status.cpy".
01 LS-CONFIG-PATH          PIC X(256) VALUE "calmgr.conf".
01 LS-FS                   PIC XX.
LOCAL-STORAGE SECTION.
01 LS-KEY                  PIC X(40).
01 LS-VALUE                PIC X(256).
LINKAGE SECTION.
COPY "appointment-config.cpy".
01 LK-STATUS               PIC 9(3).
01 LK-MESSAGE              PIC X(160).
PROCEDURE DIVISION USING APPOINTMENT-CONFIG LK-STATUS LK-MESSAGE.
    INITIALIZE APPOINTMENT-CONFIG LK-MESSAGE
    MOVE "data/appointments.db" TO AC-DATA-FILE
    MOVE "data/appointments.backup.db" TO AC-BACKUP-FILE
    MOVE "data/appointments.safety.db" TO AC-SAFETY-FILE
    MOVE "data/appointment-audit.log" TO AC-AUDIT-FILE
    MOVE "data/appointment-calendar.txt" TO AC-PRINT-FILE
    MOVE "data/appointment-list.txt" TO AC-LIST-PRINT-FILE
    MOVE "data/appointments.csv" TO AC-CSV-FILE
    MOVE "data/appointments.ics" TO AC-ICAL-FILE
    MOVE "data/appointments.lock" TO AC-LOCK-FILE
    MOVE 70 TO AC-LINES-PER-PAGE
    MOVE 90 TO AC-CANCEL-RETENTION
    OPEN INPUT CONFIG-FILE
    IF LS-FS = "35"
      MOVE APPT-OK TO LK-STATUS
      GOBACK
    END-IF
    IF LS-FS NOT = "00"
      MOVE APPT-IO-ERROR TO LK-STATUS
      MOVE "Configuration file could not be opened" TO LK-MESSAGE
      GOBACK
    END-IF
    PERFORM UNTIL LS-FS NOT = "00"
      READ CONFIG-FILE
        AT END CONTINUE
        NOT AT END
          IF CONFIG-LINE NOT = SPACES AND CONFIG-LINE(1:1) NOT = "#"
            INITIALIZE LS-KEY LS-VALUE
            UNSTRING CONFIG-LINE DELIMITED BY "=" INTO LS-KEY LS-VALUE
            EVALUATE FUNCTION TRIM(LS-KEY)
              WHEN "DATABASE_FILE" MOVE FUNCTION TRIM(LS-VALUE) TO AC-DATA-FILE
              WHEN "BACKUP_FILE" MOVE FUNCTION TRIM(LS-VALUE) TO AC-BACKUP-FILE
              WHEN "SAFETY_FILE" MOVE FUNCTION TRIM(LS-VALUE) TO AC-SAFETY-FILE
              WHEN "AUDIT_FILE" MOVE FUNCTION TRIM(LS-VALUE) TO AC-AUDIT-FILE
              WHEN "PRINT_FILE" MOVE FUNCTION TRIM(LS-VALUE) TO AC-PRINT-FILE
              WHEN "LIST_PRINT_FILE"
                MOVE FUNCTION TRIM(LS-VALUE) TO AC-LIST-PRINT-FILE
              WHEN "CSV_FILE" MOVE FUNCTION TRIM(LS-VALUE) TO AC-CSV-FILE
              WHEN "ICAL_FILE" MOVE FUNCTION TRIM(LS-VALUE) TO AC-ICAL-FILE
              WHEN "LOCK_FILE" MOVE FUNCTION TRIM(LS-VALUE) TO AC-LOCK-FILE
              WHEN "LINES_PER_PAGE" MOVE FUNCTION NUMVAL(LS-VALUE) TO AC-LINES-PER-PAGE
              WHEN "CANCEL_RETENTION_DAYS" MOVE FUNCTION NUMVAL(LS-VALUE) TO AC-CANCEL-RETENTION
              WHEN OTHER CONTINUE
            END-EVALUATE
          END-IF
      END-READ
    END-PERFORM
    CLOSE CONFIG-FILE
    IF AC-LINES-PER-PAGE < 20 OR AC-LINES-PER-PAGE > 200
      MOVE APPT-INVALID-REQUEST TO LK-STATUS
      MOVE "LINES_PER_PAGE must be between 20 and 200" TO LK-MESSAGE
    ELSE
      MOVE APPT-OK TO LK-STATUS
    END-IF
    GOBACK.
END PROGRAM APPOINTMENT-CONFIG-ADAPTER.
