>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. APPOINTMENT-JSON.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT JSON-IN ASSIGN TO DYNAMIC WS-IN-PATH
      ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS WS-IN-FS.
    SELECT JSON-OUT ASSIGN TO DYNAMIC WS-TEMP-PATH
      ORGANIZATION IS LINE SEQUENTIAL FILE STATUS IS WS-OUT-FS.
DATA DIVISION.
FILE SECTION.
FD JSON-IN.
01 JSON-IN-LINE          PIC X(1024).
FD JSON-OUT.
01 JSON-OUT-LINE         PIC X(2048).
WORKING-STORAGE SECTION.
COPY "appointment-status.cpy".
01 WS-IN-PATH            PIC X(256).
01 WS-OUT-PATH           PIC X(256).
01 WS-TEMP-PATH          PIC X(256).
01 WS-IN-FS              PIC XX.
01 WS-OUT-FS             PIC XX.
01 WS-FIRST-ITEM         PIC X VALUE "Y".
01 WS-STDIN-STATUS       PIC X.
LOCAL-STORAGE SECTION.
01 LS-KEY                PIC X(64).
01 LS-VALUE              PIC X(1024).
01 LS-JUNK-1             PIC X(1024).
01 LS-JUNK-2             PIC X(1024).
01 LS-JUNK-3             PIC X(1024).
01 LS-ESCAPED            PIC X(1024).
01 LS-I                  PIC 9(4) COMP-5.
01 LS-O                  PIC 9(4) COMP-5.
01 LS-RETURN             PIC S9(9) COMP-5.
01 LS-LEN                PIC 9(4) COMP-5.
01 LS-CHAR               PIC X.
01 LS-CODE-DISPLAY       PIC ZZ9.
01 LS-COUNT-DISPLAY      PIC Z(5)9.
01 LS-SAW-OPEN           PIC X.
01 LS-SAW-CLOSE          PIC X.
01 LS-SEEN-COUNT         PIC 99 COMP-5.
01 LS-SEEN-KEYS.
   05 LS-SEEN-KEY        PIC X(64) OCCURS 50 TIMES.
01 LS-K                  PIC 99 COMP-5.
01 LS-DUPLICATE          PIC X.
LINKAGE SECTION.
01 LK-OPERATION          PIC X(16).
01 LK-REQUEST-PATH       PIC X(256).
01 LK-RESPONSE-PATH      PIC X(256).
COPY "appointment-service-request.cpy".
COPY "appointment-service-result.cpy".
PROCEDURE DIVISION USING LK-OPERATION LK-REQUEST-PATH LK-RESPONSE-PATH
    APPOINTMENT-SERVICE-REQUEST APPOINTMENT-SERVICE-RESULT.
    EVALUATE FUNCTION TRIM(LK-OPERATION)
      WHEN "READ" PERFORM READ-REQUEST
      WHEN "OPEN" PERFORM OPEN-RESPONSE
      WHEN "ITEM" PERFORM WRITE-ITEM
      WHEN "CLOSE" PERFORM CLOSE-RESPONSE
      WHEN "AUTH" PERFORM WRITE-AUTH-RESPONSE
      WHEN "USERS-OPEN" PERFORM OPEN-USERS-RESPONSE
      WHEN "USER-ITEM" PERFORM WRITE-USER-ITEM
      WHEN "USERS-CLOSE" PERFORM CLOSE-USERS-RESPONSE
      WHEN OTHER
        MOVE APPT-INTERNAL-ERROR TO ASO-STATUS-CODE
        MOVE "Unknown JSON adapter operation" TO ASO-MESSAGE
    END-EVALUATE
    GOBACK.

READ-REQUEST.
    INITIALIZE APPOINTMENT-SERVICE-REQUEST APPOINTMENT-SERVICE-RESULT
      LS-SAW-OPEN LS-SAW-CLOSE LS-SEEN-COUNT LS-SEEN-KEYS WS-STDIN-STATUS
    MOVE LK-REQUEST-PATH TO WS-IN-PATH
    IF FUNCTION TRIM(WS-IN-PATH) = "@STDIN"
      PERFORM UNTIL WS-STDIN-STATUS = "Y"
        CALL "appt_read_stdin" USING JSON-IN-LINE WS-STDIN-STATUS
        IF WS-STDIN-STATUS NOT = "Y" PERFORM PARSE-PROPERTY END-IF
      END-PERFORM
      IF (LS-SAW-OPEN NOT = "Y" OR LS-SAW-CLOSE NOT = "Y")
        AND ASO-STATUS-CODE = APPT-OK
        MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
        MOVE "Request must contain one complete JSON object" TO ASO-MESSAGE
      END-IF
      IF ASR-OPERATION = SPACES AND ASO-STATUS-CODE = APPT-OK
        MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
        MOVE "The command property is required" TO ASO-MESSAGE
      END-IF
      EXIT PARAGRAPH
    END-IF
    OPEN INPUT JSON-IN
    IF WS-IN-FS NOT = "00"
      MOVE APPT-IO-ERROR TO ASO-STATUS-CODE
      MOVE "Request file could not be opened" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    PERFORM UNTIL WS-IN-FS NOT = "00" OR ASO-STATUS-CODE NOT = APPT-OK
      READ JSON-IN
        AT END CONTINUE
        NOT AT END PERFORM PARSE-PROPERTY
      END-READ
    END-PERFORM
    CLOSE JSON-IN
    IF (LS-SAW-OPEN NOT = "Y" OR LS-SAW-CLOSE NOT = "Y")
      AND ASO-STATUS-CODE = APPT-OK
      MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
      MOVE "Request must contain one complete JSON object" TO ASO-MESSAGE
    END-IF
    IF ASR-OPERATION = SPACES AND ASO-STATUS-CODE = APPT-OK
      MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
      MOVE "The command property is required" TO ASO-MESSAGE
    END-IF.

PARSE-PROPERTY.
    IF FUNCTION TRIM(JSON-IN-LINE) = "{"
      IF LS-SAW-OPEN = "Y" PERFORM JSON-SYNTAX-ERROR
      ELSE MOVE "Y" TO LS-SAW-OPEN END-IF
      EXIT PARAGRAPH
    END-IF
    IF FUNCTION TRIM(JSON-IN-LINE) = "}"
      MOVE "Y" TO LS-SAW-CLOSE EXIT PARAGRAPH
    END-IF
    IF FUNCTION TRIM(JSON-IN-LINE) = SPACES EXIT PARAGRAPH END-IF
    IF LS-SAW-OPEN NOT = "Y" OR LS-SAW-CLOSE = "Y"
      PERFORM JSON-SYNTAX-ERROR EXIT PARAGRAPH
    END-IF
    INITIALIZE LS-KEY LS-VALUE LS-I LS-O
    COMPUTE LS-LEN = FUNCTION LENGTH(FUNCTION TRIM(JSON-IN-LINE TRAILING))
    MOVE 1 TO LS-I
    PERFORM UNTIL LS-I > LS-LEN OR JSON-IN-LINE(LS-I:1) NOT = SPACE
      ADD 1 TO LS-I
    END-PERFORM
    IF LS-I > LS-LEN OR JSON-IN-LINE(LS-I:1) NOT = '"'
      PERFORM JSON-SYNTAX-ERROR EXIT PARAGRAPH
    END-IF
    ADD 1 TO LS-I
    PERFORM UNTIL LS-I > LS-LEN OR JSON-IN-LINE(LS-I:1) = '"'
      ADD 1 TO LS-O MOVE JSON-IN-LINE(LS-I:1) TO LS-KEY(LS-O:1)
      ADD 1 TO LS-I
    END-PERFORM
    MOVE "N" TO LS-DUPLICATE
    PERFORM VARYING LS-K FROM 1 BY 1 UNTIL LS-K > LS-SEEN-COUNT
      IF LS-SEEN-KEY(LS-K) = LS-KEY MOVE "Y" TO LS-DUPLICATE END-IF
    END-PERFORM
    IF LS-DUPLICATE = "Y"
      MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
      MOVE "Duplicate JSON property" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    IF LS-SEEN-COUNT >= 50
      MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
      MOVE "Too many JSON properties" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    ADD 1 TO LS-SEEN-COUNT MOVE LS-KEY TO LS-SEEN-KEY(LS-SEEN-COUNT)
    ADD 1 TO LS-I
    PERFORM UNTIL LS-I > LS-LEN OR JSON-IN-LINE(LS-I:1) = ":"
      ADD 1 TO LS-I
    END-PERFORM
    IF LS-I > LS-LEN PERFORM JSON-SYNTAX-ERROR EXIT PARAGRAPH END-IF
    ADD 1 TO LS-I
    PERFORM UNTIL LS-I > LS-LEN OR JSON-IN-LINE(LS-I:1) NOT = SPACE
      ADD 1 TO LS-I
    END-PERFORM
    IF LS-I > LS-LEN OR JSON-IN-LINE(LS-I:1) NOT = '"'
      PERFORM JSON-SYNTAX-ERROR EXIT PARAGRAPH
    END-IF
    ADD 1 TO LS-I MOVE 0 TO LS-O
    PERFORM UNTIL LS-I > LS-LEN OR JSON-IN-LINE(LS-I:1) = '"'
      MOVE JSON-IN-LINE(LS-I:1) TO LS-CHAR
      IF LS-CHAR = "\"
        ADD 1 TO LS-I
        IF LS-I > LS-LEN PERFORM JSON-SYNTAX-ERROR EXIT PERFORM END-IF
        EVALUATE JSON-IN-LINE(LS-I:1)
          WHEN '"' MOVE '"' TO LS-CHAR
          WHEN "\" MOVE "\" TO LS-CHAR
          WHEN "/" MOVE "/" TO LS-CHAR
          WHEN "n" WHEN "r" WHEN "t" MOVE SPACE TO LS-CHAR
          WHEN OTHER PERFORM JSON-SYNTAX-ERROR EXIT PERFORM
        END-EVALUATE
      END-IF
      ADD 1 TO LS-O
      IF LS-O <= FUNCTION LENGTH(LS-VALUE) MOVE LS-CHAR TO LS-VALUE(LS-O:1) END-IF
      ADD 1 TO LS-I
    END-PERFORM
    IF LS-I > LS-LEN PERFORM JSON-SYNTAX-ERROR EXIT PARAGRAPH END-IF
    EVALUATE FUNCTION LOWER-CASE(FUNCTION TRIM(LS-KEY))
      WHEN "command" MOVE FUNCTION UPPER-CASE(FUNCTION TRIM(LS-VALUE)) TO ASR-OPERATION
      WHEN "id"
        IF LS-O > 9 PERFORM JSON-VALUE-TOO-LONG
        ELSE MOVE LS-VALUE(1:9) TO ASR-ID END-IF
      WHEN "series_id"
        IF LS-O > 9 PERFORM JSON-VALUE-TOO-LONG
        ELSE MOVE LS-VALUE(1:9) TO ASR-SERIES-ID END-IF
      WHEN "scope" MOVE FUNCTION LOWER-CASE(FUNCTION TRIM(LS-VALUE)) TO ASR-SCOPE
      WHEN "mode" MOVE FUNCTION LOWER-CASE(FUNCTION TRIM(LS-VALUE)) TO ASR-MODE
      WHEN "start_date" PERFORM PARSE-START-DATE
      WHEN "end_date" PERFORM PARSE-END-DATE
      WHEN "series_until" PERFORM PARSE-SERIES-DATE
      WHEN "from_date" PERFORM PARSE-FROM-DATE
      WHEN "to_date" PERFORM PARSE-TO-DATE
      WHEN "client"
        IF LS-O > 60 PERFORM JSON-VALUE-TOO-LONG
        ELSE MOVE LS-VALUE(1:60) TO ASR-CLIENT END-IF
      WHEN "subject"
        IF LS-O > 100 PERFORM JSON-VALUE-TOO-LONG
        ELSE MOVE LS-VALUE(1:100) TO ASR-SUBJECT END-IF
      WHEN "status" MOVE FUNCTION UPPER-CASE(LS-VALUE(1:1)) TO ASR-STATUS
      WHEN "recurrence" MOVE FUNCTION UPPER-CASE(LS-VALUE(1:1)) TO ASR-RECURRENCE
      WHEN "cancel_note"
        IF LS-O > 120 PERFORM JSON-VALUE-TOO-LONG
        ELSE MOVE LS-VALUE(1:120) TO ASR-CANCEL-NOTE END-IF
      WHEN "query"
        IF LS-O > 100 PERFORM JSON-VALUE-TOO-LONG
        ELSE MOVE LS-VALUE(1:100) TO ASR-QUERY END-IF
      WHEN "sort" MOVE FUNCTION LOWER-CASE(LS-VALUE) TO ASR-SORT
      WHEN "expected_revision"
        IF FUNCTION TEST-NUMVAL(LS-VALUE) = 0
          MOVE FUNCTION NUMVAL(LS-VALUE) TO ASR-EXPECTED-REVISION
        ELSE PERFORM JSON-VALUE-ERROR END-IF
      WHEN "confirm"
        IF LS-O > 16 PERFORM JSON-VALUE-TOO-LONG
        ELSE MOVE LS-VALUE(1:16) TO ASR-CONFIRM END-IF
      WHEN "path"
        IF LS-O > 256 PERFORM JSON-VALUE-TOO-LONG
        ELSE MOVE LS-VALUE(1:256) TO ASR-PATH END-IF
      WHEN "source" MOVE FUNCTION UPPER-CASE(LS-VALUE) TO ASR-SOURCE
      WHEN "username"
        IF LS-O < 1 OR LS-O > 64 PERFORM JSON-VALUE-TOO-LONG
        ELSE MOVE LS-VALUE(1:LS-O) TO ASR-USERNAME END-IF
      WHEN "password"
        IF LS-O < 1 OR LS-O > 256 PERFORM JSON-VALUE-TOO-LONG
        ELSE MOVE LS-VALUE(1:LS-O) TO ASR-PASSWORD END-IF
      WHEN "actor_username"
        IF LS-O < 1 OR LS-O > 64 PERFORM JSON-VALUE-TOO-LONG
        ELSE MOVE LS-VALUE(1:LS-O) TO ASR-ACTOR-USERNAME END-IF
      WHEN "actor_password"
        IF LS-O < 1 OR LS-O > 256 PERFORM JSON-VALUE-TOO-LONG
        ELSE MOVE LS-VALUE(1:LS-O) TO ASR-ACTOR-PASSWORD END-IF
      WHEN "new_password"
        IF LS-O < 1 OR LS-O > 256 PERFORM JSON-VALUE-TOO-LONG
        ELSE MOVE LS-VALUE(1:LS-O) TO ASR-NEW-PASSWORD END-IF
      WHEN "role"
        IF LS-O > 8 PERFORM JSON-VALUE-TOO-LONG
        ELSE MOVE FUNCTION LOWER-CASE(LS-VALUE(1:LS-O)) TO ASR-ROLE END-IF
      WHEN "user_id"
        IF LS-O > 12 PERFORM JSON-VALUE-TOO-LONG
        ELSE MOVE LS-VALUE(1:LS-O) TO ASR-USER-ID END-IF
      WHEN OTHER
        MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
        STRING "Unknown JSON property: " FUNCTION TRIM(LS-KEY) INTO ASO-MESSAGE END-STRING
    END-EVALUATE.

JSON-SYNTAX-ERROR.
    MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
    MOVE "Each JSON property must be a quoted string on its own line"
      TO ASO-MESSAGE.

PARSE-START-DATE.
    PERFORM NORMALIZE-DATE
    IF LS-VALUE(1:8) IS NUMERIC MOVE LS-VALUE(1:8) TO ASR-START-DATE
    ELSE PERFORM JSON-VALUE-ERROR END-IF.
PARSE-END-DATE.
    PERFORM NORMALIZE-DATE
    IF LS-VALUE(1:8) IS NUMERIC MOVE LS-VALUE(1:8) TO ASR-END-DATE
    ELSE PERFORM JSON-VALUE-ERROR END-IF.
PARSE-SERIES-DATE.
    PERFORM NORMALIZE-DATE
    IF LS-VALUE(1:8) IS NUMERIC MOVE LS-VALUE(1:8) TO ASR-SERIES-UNTIL
    ELSE PERFORM JSON-VALUE-ERROR END-IF.
PARSE-FROM-DATE.
    PERFORM NORMALIZE-DATE
    IF LS-VALUE(1:8) IS NUMERIC MOVE LS-VALUE(1:8) TO ASR-FROM-DATE
    ELSE PERFORM JSON-VALUE-ERROR END-IF.
PARSE-TO-DATE.
    PERFORM NORMALIZE-DATE
    IF LS-VALUE(1:8) IS NUMERIC MOVE LS-VALUE(1:8) TO ASR-TO-DATE
    ELSE PERFORM JSON-VALUE-ERROR END-IF.
JSON-VALUE-ERROR.
    MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
    MOVE "JSON property has an invalid value" TO ASO-MESSAGE.
JSON-VALUE-TOO-LONG.
    MOVE APPT-INVALID-REQUEST TO ASO-STATUS-CODE
    MOVE "JSON property value is too long" TO ASO-MESSAGE.
NORMALIZE-DATE.
    IF LS-VALUE(5:1) = "-" AND LS-VALUE(8:1) = "-"
      STRING LS-VALUE(1:4) LS-VALUE(6:2) LS-VALUE(9:2) INTO LS-JUNK-1 END-STRING
      MOVE LS-JUNK-1(1:8) TO LS-VALUE(1:8)
    ELSE IF LS-VALUE(3:1) = "." AND LS-VALUE(6:1) = "."
      STRING LS-VALUE(7:4) LS-VALUE(4:2) LS-VALUE(1:2) INTO LS-JUNK-1 END-STRING
      MOVE LS-JUNK-1(1:8) TO LS-VALUE(1:8)
    END-IF.

OPEN-RESPONSE.
    MOVE LK-RESPONSE-PATH TO WS-OUT-PATH
    INITIALIZE WS-TEMP-PATH
    STRING FUNCTION TRIM(WS-OUT-PATH) ".tmp" INTO WS-TEMP-PATH END-STRING
    OPEN OUTPUT JSON-OUT
    IF WS-OUT-FS NOT = "00"
      MOVE APPT-IO-ERROR TO ASO-STATUS-CODE
      MOVE "Response temporary file could not be opened" TO ASO-MESSAGE
      EXIT PARAGRAPH
    END-IF
    MOVE "Y" TO WS-FIRST-ITEM
    PERFORM ESCAPE-MESSAGE
    MOVE ASO-COUNT TO LS-COUNT-DISPLAY
    MOVE ASO-STATUS-CODE TO LS-CODE-DISPLAY
    INITIALIZE JSON-OUT-LINE
    IF ASO-STATUS-CODE = APPT-OK
      STRING '{"ok":true,"code":' FUNCTION TRIM(LS-CODE-DISPLAY)
        ',"message":"' FUNCTION TRIM(LS-ESCAPED) '","count":'
        FUNCTION TRIM(LS-COUNT-DISPLAY) ',"output_path":"'
        FUNCTION TRIM(ASO-OUTPUT-PATH) '","appointments":['
        INTO JSON-OUT-LINE END-STRING
    ELSE
      STRING '{"ok":false,"code":' FUNCTION TRIM(LS-CODE-DISPLAY)
        ',"message":"' FUNCTION TRIM(LS-ESCAPED)
        '","count":0,"output_path":"","appointments":['
        INTO JSON-OUT-LINE END-STRING
    END-IF
    WRITE JSON-OUT-LINE.

WRITE-ITEM.
    PERFORM ESCAPE-CLIENT
    MOVE LS-ESCAPED TO LS-JUNK-1
    PERFORM ESCAPE-SUBJECT
    IF WS-FIRST-ITEM = "N" MOVE "," TO JSON-OUT-LINE WRITE JSON-OUT-LINE END-IF
    INITIALIZE JSON-OUT-LINE
    STRING '{"id":"' ASO-ID '","series_id":"' ASO-SERIES-ID
      '","start_date":"' ASO-START-DATE '","end_date":"' ASO-END-DATE
      '","iso_year":"' ASO-ISO-YEAR '","iso_week":"' ASO-ISO-WEEK
      '","client":"' FUNCTION TRIM(LS-JUNK-1) '","subject":"'
      FUNCTION TRIM(LS-ESCAPED) '","status":"' ASO-STATUS
      '","recurrence":"' ASO-RECURRENCE '","series_until":"'
      ASO-SERIES-UNTIL '","revision":"' ASO-REVISION '"}'
      INTO JSON-OUT-LINE END-STRING
    WRITE JSON-OUT-LINE
    MOVE "N" TO WS-FIRST-ITEM.

CLOSE-RESPONSE.
    MOVE "]}" TO JSON-OUT-LINE WRITE JSON-OUT-LINE
    CLOSE JSON-OUT
    CALL "CBL_RENAME_FILE" USING WS-TEMP-PATH WS-OUT-PATH RETURNING LS-RETURN
    IF LS-RETURN NOT = 0
      MOVE APPT-IO-ERROR TO ASO-STATUS-CODE
      MOVE "Response could not be installed atomically" TO ASO-MESSAGE
    END-IF.

WRITE-AUTH-RESPONSE.
    MOVE LK-RESPONSE-PATH TO WS-OUT-PATH
    INITIALIZE WS-TEMP-PATH JSON-OUT-LINE
    STRING FUNCTION TRIM(WS-OUT-PATH) ".tmp" INTO WS-TEMP-PATH END-STRING
    OPEN OUTPUT JSON-OUT
    MOVE ASO-STATUS-CODE TO LS-CODE-DISPLAY
    PERFORM ESCAPE-MESSAGE
    IF ASO-STATUS-CODE = APPT-OK
      STRING '{"ok":true,"code":' FUNCTION TRIM(LS-CODE-DISPLAY)
        ',"message":"' FUNCTION TRIM(LS-ESCAPED) '","user":{"user_id":"'
        FUNCTION TRIM(ASO-USER-ID) '","username":"'
        FUNCTION TRIM(ASO-USERNAME) '","role":"'
        FUNCTION TRIM(ASO-ROLE) '"},"appointments":[]}'
        INTO JSON-OUT-LINE END-STRING
    ELSE
      STRING '{"ok":false,"code":' FUNCTION TRIM(LS-CODE-DISPLAY)
        ',"message":"' FUNCTION TRIM(LS-ESCAPED)
        '","user":null,"appointments":[]}' INTO JSON-OUT-LINE END-STRING
    END-IF
    WRITE JSON-OUT-LINE CLOSE JSON-OUT
    CALL "CBL_RENAME_FILE" USING WS-TEMP-PATH WS-OUT-PATH RETURNING LS-RETURN.

OPEN-USERS-RESPONSE.
    MOVE LK-RESPONSE-PATH TO WS-OUT-PATH
    INITIALIZE WS-TEMP-PATH JSON-OUT-LINE
    STRING FUNCTION TRIM(WS-OUT-PATH) ".tmp" INTO WS-TEMP-PATH END-STRING
    OPEN OUTPUT JSON-OUT
    MOVE "Y" TO WS-FIRST-ITEM
    MOVE ASO-STATUS-CODE TO LS-CODE-DISPLAY
    PERFORM ESCAPE-MESSAGE
    IF ASO-STATUS-CODE = APPT-OK
      STRING '{"ok":true,"code":' FUNCTION TRIM(LS-CODE-DISPLAY)
        ',"message":"' FUNCTION TRIM(LS-ESCAPED)
        '","users":[' INTO JSON-OUT-LINE END-STRING
    ELSE
      STRING '{"ok":false,"code":' FUNCTION TRIM(LS-CODE-DISPLAY)
        ',"message":"' FUNCTION TRIM(LS-ESCAPED)
        '","users":[' INTO JSON-OUT-LINE END-STRING
    END-IF
    WRITE JSON-OUT-LINE.

WRITE-USER-ITEM.
    IF WS-FIRST-ITEM = "N" MOVE "," TO JSON-OUT-LINE WRITE JSON-OUT-LINE END-IF
    INITIALIZE JSON-OUT-LINE
    STRING '{"user_id":"' FUNCTION TRIM(ASO-USER-ID)
      '","username":"' FUNCTION TRIM(ASO-USERNAME)
      '","role":"' FUNCTION TRIM(ASO-ROLE)
      '","active":"' ASO-USER-ACTIVE
      '","revision":"' ASO-USER-REVISION '"}'
      INTO JSON-OUT-LINE END-STRING
    WRITE JSON-OUT-LINE MOVE "N" TO WS-FIRST-ITEM.

CLOSE-USERS-RESPONSE.
    MOVE '],"appointments":[]}' TO JSON-OUT-LINE WRITE JSON-OUT-LINE
    CLOSE JSON-OUT
    CALL "CBL_RENAME_FILE" USING WS-TEMP-PATH WS-OUT-PATH RETURNING LS-RETURN.

ESCAPE-MESSAGE.
    MOVE ASO-MESSAGE TO LS-VALUE PERFORM ESCAPE-TEXT.
ESCAPE-CLIENT.
    MOVE ASO-CLIENT TO LS-VALUE PERFORM ESCAPE-TEXT.
ESCAPE-SUBJECT.
    MOVE ASO-SUBJECT TO LS-VALUE PERFORM ESCAPE-TEXT.
ESCAPE-TEXT.
    INITIALIZE LS-ESCAPED LS-O
    PERFORM VARYING LS-I FROM 1 BY 1 UNTIL LS-I > FUNCTION LENGTH(FUNCTION TRIM(LS-VALUE))
      IF LS-VALUE(LS-I:1) = '"' OR LS-VALUE(LS-I:1) = "\"
        ADD 1 TO LS-O MOVE "\" TO LS-ESCAPED(LS-O:1)
      END-IF
      ADD 1 TO LS-O MOVE LS-VALUE(LS-I:1) TO LS-ESCAPED(LS-O:1)
    END-PERFORM.
END PROGRAM APPOINTMENT-JSON.
